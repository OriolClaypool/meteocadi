---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/schibsted-grotesk/wght-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string; // "/", "/estacions", ...
  image?: string;
  jsonLd?: object[];
  noindex?: boolean;
  header?: 'overlay' | 'solid';
  current?: string;
  preload?: string;
  bare?: boolean; // sense capçalera ni peu del web (eines internes)
  lang?: 'ca' | 'es'; // el castellà només a /es/
  alternates?: { ca: string; es: string }; // camins de la mateixa pàgina en cada llengua (hreflang)
  // Imatge de previsualització en compartir l'enllaç (WhatsApp, X…): una per pàgina, generada en el build
  // (integrations/og-cards.mjs). Per defecte el títol i el subtítol surten del <title> ("Títol: subtítol | Meteocadí")
  // i l'avantítol, de la secció. lat/lng: punt marcat al mapa; label: etiqueta del punt; variant: field (mapa de
  // color), radar o net (estacions de la xarxa). Amb `image` es fa servir aquesta imatge i no se'n genera cap.
  card?: { kicker?: string; title?: string; sub?: string; lat?: number; lng?: number; label?: string; variant?: 'field' | 'radar' | 'net'; pins?: [number, number][] };
}

const { title, description, path, image, card = {}, jsonLd = [], noindex = false, header = 'solid', current = '', preload, bare = false, lang = 'ca', alternates } = Astro.props;
const site = 'https://www.meteocadi.cat';
const url = site + (path === '/' ? '/' : path);

// Targeta de previsualització: la portada manté la foto del Cadí; la resta de pàgines, la seva
const es = lang === 'es';
const KICKERS: [RegExp, string, string][] = [
  [/^\/estudi\b/, 'Estudi · eina interna', 'Estudi · eina interna'],
  [/^\/estacions\/./, 'Estació de la xarxa Meteocadí', 'Estación de la red Meteocadí'],
  [/^\/(estacions|mapa)$/, 'Xarxa Meteocadí', 'Red Meteocadí'],
  [/^\/mapa\/catalunya/, 'Mapa en directe', 'Mapa en directo'],
  [/^\/radar/, 'Radar', 'Radar'],
  [/^(\/es)?\/(esqui)/, 'Esquí', 'Esquí'],
  [/^(\/es)?\/(muntanya|montana)/, 'Muntanya', 'Montaña'],
  [/^\/cap-de-setmana/, 'Cap de setmana', 'Fin de semana'],
  [/^\/(historial|episodis)/, 'Historial', 'Historial'],
  [/^\/webcams/, 'Webcams', 'Webcams'],
  [/^(\/es)?\/(temps|tiempo)/, 'Previsió del temps', 'Previsión del tiempo'],
];
const cap = (t: string) => (t ? t[0].toUpperCase() + t.slice(1) : t);
const bare_ = title.replace(/\s*\|\s*Meteocad[ií]\s*$/, '');
const cut = bare_.indexOf(': ');
const kick = KICKERS.find(([re]) => re.test(path));
// Sense subtítol al <title>: la primera frase de la descripció, si és curta
const first = description.split(/(?<=\.)\s/)[0].replace(/\.$/, '');
const shortDesc = first.length <= 110 ? first : undefined;
const ogCard = path === '/' || image ? null : {
  o: `/og${path}.jpg`,
  k: card.kicker ?? (kick ? kick[es ? 2 : 1] : 'Meteocadí'),
  t: card.title ?? (cut > 0 ? bare_.slice(0, cut) : bare_.replace(/^Estudi · /, '')),
  s: card.sub ?? (cut > 0 ? cap(bare_.slice(cut + 2)) : shortDesc),
  lat: card.lat, lng: card.lng, m: card.label, v: card.variant, pins: card.pins,
};
const imgPath = ogCard ? ogCard.o : image ?? '/imatges/og-meteocadi.jpg';
const img = imgPath.startsWith('http') ? imgPath : site + imgPath;
const altPath = alternates ? (lang === 'es' ? alternates.ca : alternates.es) : undefined;

const graph = [
  {
    '@type': 'Organization',
    '@id': `${site}/#org`,
    name: 'Meteocadí',
    url: `${site}/`,
    logo: `${site}/imatges/logo-256.png`,
    sameAs: ['https://x.com/meteocadi'],
    description: "Xarxa d'estacions meteorològiques al Cadí-Moixeró i el Berguedà, en col·laboració amb el Parc Natural del Cadí-Moixeró.",
  },
  { '@type': 'WebSite', '@id': `${site}/#web`, name: 'Meteocadí', url: `${site}/`, inLanguage: 'ca', publisher: { '@id': `${site}/#org` } },
  ...jsonLd,
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="ca" href={site + alternates.ca} />
        <link rel="alternate" hreflang="es" href={site + alternates.es} />
        <link rel="alternate" hreflang="x-default" href={site + alternates.ca} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#10233b" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'ca_ES'} />
    {alternates && <meta property="og:locale:alternate" content={lang === 'es' ? 'ca_ES' : 'es_ES'} />}
    <meta property="og:site_name" content="Meteocadí" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={img} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogCard ? ogCard.t : 'Meteocadí'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@meteocadi" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    {ogCard && <meta name="mc-og" content={JSON.stringify(ogCard)} />}
    <slot name="head" />
  </head>
  <body>
    <div class="strip" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    {!bare && <Header variant={header} current={current} lang={lang} alt={altPath} />}
    <main>
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    <script>
      // Pausa les animacions de les seccions que no es veuen (menys feina mentre es desplaça la pàgina)
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-off', !e.isIntersecting)), { rootMargin: '100px' });
        document.querySelectorAll('main > section, main > .ticker').forEach((el) => io.observe(el));
      }
      const hdr = document.querySelector('.hdr');
      const btn = document.querySelector('.nav-btn');
      btn?.addEventListener('click', () => {
        const open = hdr?.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
