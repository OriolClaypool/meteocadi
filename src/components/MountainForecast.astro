---
// Condicions previstes a la muntanya (3 dies) per als punts d'un lloc.
// Es genera en el build (queda al codi HTML) i es refresca al navegador amb la previsió del moment.
import { fetchMountain, mountainTableHTML } from '../lib/mountain.js';
import { t } from '../lib/i18n.js';
interface Props { points: { label: string; lat: number; lng: number; alt: number }[]; title?: string; sub?: string; data?: any; lang?: 'ca' | 'es' }
const { points, title: given_title, sub = '', data: given, lang = 'ca' } = Astro.props;
const L = t(lang);
const title = given_title ?? L.mtTitle;
const data = given ?? (await fetchMountain(points));
const html = mountainTableHTML(data, lang);
---
<div class="mfc" data-mfc={JSON.stringify(points)}>
  <div class="sec__head">
    <div>
      <span class="eyebrow">{L.mtEyebrow}</span>
      <h2 class="h2">{title}</h2>
      {sub && <p class="sub">{sub}</p>}
    </div>
  </div>
  <div class="tscroll" data-mfc-table set:html={html || `<p class="mfc__load">${L.loadingFc}</p>`}></div>
  <p class="mfc__note">{L.mtNote}</p>
</div>
<script>
  import { fetchMountain, mountainTableHTML } from '../lib/mountain.js';
  import { pageLang } from '../lib/i18n.js';
  document.querySelectorAll<HTMLElement>('[data-mfc]').forEach(async (root) => {
    const points = JSON.parse(root.dataset.mfc || '[]');
    const data = await fetchMountain(points, 3, 10000);
    const html = mountainTableHTML(data, pageLang());
    const box = root.querySelector('[data-mfc-table]');
    if (html && box) box.innerHTML = html;
  });
</script>
