---
// Portada, de novembre a abril: una sola franja cap a Meteocadí Neu (/neu) amb la frase del dia (el parte de Neu o, sense
// neu enlloc, la primera nevada prevista). Al build es pinta amb la previsió d'aquell moment; el navegador la refà amb /api/neu.
import { NEU, lleugera } from '../lib/neu/estacions.js';
import { previsioBuild } from '../lib/neu/build.js';
import { groupsOf, neuSentence } from '../lib/neu/neu.js';
import { todayMadrid } from '../lib/format.js';

const lite = NEU.map(lleugera);
const today = todayMadrid();
const groups = groupsOf(lite, await previsioBuild());
const text = groups ? neuSentence(groups, today) : '';
const ARROW = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>';
---
<a class="neustrip" href="/neu" data-neustrip={JSON.stringify({ resorts: lite })}>
  <div class="wrap">
    <b>METEOCADÍ NEU</b>
    <span data-neustrip-t>{text || "Previsió de neu, cota de neu i vent a les estacions d'esquí del Pirineu."}</span>
    <u>Veure la neu <Fragment set:html={ARROW} /></u>
  </div>
</a>

<style is:global>
  .neustrip { display: block; background: #0b2a3f; color: #fff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.12); }
  .neustrip .wrap { display: flex; align-items: center; gap: 14px; padding-top: 12px; padding-bottom: 12px; font-size: 15px; line-height: 1.35; }
  .neustrip b { flex: none; font: 600 12px/1 var(--mono, 'Geist Mono', monospace); letter-spacing: .08em; color: #7fd0ff; }
  .neustrip span { flex: 1; min-width: 0; }
  .neustrip u { flex: none; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: #7fd0ff; font-weight: 600; white-space: nowrap; }
  .neustrip:hover u { color: #fff; }
  @media (max-width: 640px) {
    .neustrip .wrap { flex-wrap: wrap; gap: 4px 12px; padding-top: 10px; padding-bottom: 10px; font-size: 14px; }
    .neustrip b { width: 100%; }
    .neustrip span { flex: 1 1 100%; }
  }
</style>

<script>
  import { groupsOf, neuSentence } from '../lib/neu/neu.js';
  import { todayMadrid } from '../lib/format.js';
  const a = document.querySelector<HTMLElement>('[data-neustrip]');
  const t = a?.querySelector<HTMLElement>('[data-neustrip-t]');
  if (a && t) {
    const { resorts } = JSON.parse(a.dataset.neustrip || '{}');
    const paint = () =>
      fetch('/api/neu')
        .then((r) => (r.ok ? r.json() : null))
        .then((fc) => {
          if (!fc?.resorts || !Object.keys(fc.resorts).length) return;
          const g = groupsOf(resorts, fc);
          const s = g ? neuSentence(g, todayMadrid()) : '';
          if (s) t.textContent = s;
        })
        .catch(() => {});
    paint();
    setInterval(paint, 30 * 60 * 1000);
  }
</script>
