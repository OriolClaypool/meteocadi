---
// Perfil tèrmic del darrer dia arxivat: màxima de cada estació segons l'altitud.
import { lapse, latestDay } from '../lib/archive.js';
import { tempColorLight, num, dayMonth, dayName } from '../lib/format.js';
import { fmtAlt } from '../lib/stations.js';

const day = latestDay();
const L = lapse(day, 'tempHigh');
const W = 720, H = 420, PX0 = 70, PX1 = 700, PY0 = 370, PY1 = 24;
let svg = '';
let text = '';
if (L) {
  const ts = L.points.map((p) => p.t);
  const TMN = Math.floor((Math.min(...ts) - 2) / 2) * 2;
  const TMX = Math.ceil((Math.max(...ts) + 2) / 2) * 2;
  const AMN = 600, AMX = 2600;
  const px = (t) => PX0 + ((t - TMN) / (TMX - TMN)) * (PX1 - PX0);
  const py = (a) => PY0 - ((a - AMN) / (AMX - AMN)) * (PY0 - PY1);
  const o = [];
  for (const a of [1000, 1500, 2000, 2500]) {
    o.push(`<line x1="${PX0}" y1="${py(a)}" x2="${PX1}" y2="${py(a)}" stroke="#e3e9f0"></line><text x="${PX0 - 12}" y="${py(a) + 5}" text-anchor="end" font-size="13" fill="#56667a" font-family="Geist Mono Variable, monospace">${fmtAlt(a)}</text>`);
  }
  const tstep = TMX - TMN > 12 ? 5 : 2;
  for (let t = Math.ceil(TMN / tstep) * tstep; t <= TMX; t += tstep) {
    o.push(`<line x1="${px(t)}" y1="${PY1}" x2="${px(t)}" y2="${PY0}" stroke="#e3e9f0" stroke-dasharray="3 5"></line><text x="${px(t)}" y="${PY0 + 24}" text-anchor="middle" font-size="13" fill="#56667a" font-family="Geist Mono Variable, monospace">${t} °C</text>`);
  }
  o.push(`<line x1="${PX0}" y1="${PY0}" x2="${PX1}" y2="${PY0}" stroke="#c7d2de"></line>`);
  const a1 = 700, a2 = 2550;
  const clampT = (t) => Math.max(TMN, Math.min(TMX, t));
  o.push(`<line x1="${px(clampT(L.intercept + L.slope * a1))}" y1="${py(a1)}" x2="${px(clampT(L.intercept + L.slope * a2))}" y2="${py(a2)}" stroke="#22477a" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.6"></line>`);
  // etiquetes: extrems i alguns punts clau sense solapar
  const hi = L.points.reduce((a, b) => (b.t > a.t ? b : a));
  const lo = L.points.reduce((a, b) => (b.t < a.t ? b : a));
  const top = L.points[L.points.length - 1];
  const bottom = L.points[0];
  const label = new Map([[hi.id, 'r'], [lo.id, 'l'], [top.id, 'l'], [bottom.id, 'l']]);
  L.points.forEach((p, i) => {
    const x = px(p.t), y = py(p.alt);
    o.push(`<circle class="a-pop" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="7" fill="${tempColorLight(p.t)}" stroke="#fff" stroke-width="2.5" style="animation-delay:${(0.2 + i * 0.07).toFixed(2)}s"><title>${p.station.name} (${fmtAlt(p.alt)}): ${num(p.t)} °C</title></circle>`);
    if (label.has(p.id)) {
      const right = label.get(p.id) === 'r';
      o.push(`<text x="${(x + (right ? 12 : -12)).toFixed(1)}" y="${(y + (p.id === bottom.id && p.id !== hi.id ? 18 : 5)).toFixed(1)}" text-anchor="${right ? 'start' : 'end'}" font-size="14" font-weight="600" fill="#10233b">${p.station.name.split(' - ')[0]} <tspan fill="${tempColorLight(p.t)}" font-weight="700">${num(p.t)}°</tspan></text>`);
    }
  });
  svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Temperatura màxima de cada estació segons la seva altitud, ${dayMonth(day.date)}">${o.join('')}</svg>`;
  const s = Math.abs(L.slope100);
  if (L.slope100 < -0.2) {
    text = `El ${dayName(day.date)} ${dayMonth(day.date)}, la màxima va baixar de mitjana <strong>${num(s, 2)} °C per cada 100 metres</strong> de desnivell: ${num(bottom.t)} °C ${bottom.station.a} (${fmtAlt(bottom.alt)}) i ${num(top.t)} °C ${top.station.a} (${fmtAlt(top.alt)}).`;
  } else if (L.slope100 > 0.2) {
    text = `El ${dayName(day.date)} ${dayMonth(day.date)} hi va haver <strong>inversió tèrmica</strong>: la màxima va pujar ${num(s, 2)} °C per cada 100 metres, amb més calor a dalt que al fons de la vall.`;
  } else {
    text = `El ${dayName(day.date)} ${dayMonth(day.date)} la màxima va ser gairebé la mateixa a totes les altituds, un senyal típic d'inversió tèrmica o de dies molt ennuvolats.`;
  }
}
---
{L && (
  <section class="sec">
    <div class="wrap perfil">
      <div style="display:flex;flex-direction:column;gap:20px;">
        <h2>Com més amunt,<br /><em>més fresc.</em></h2>
        <p set:html={text} />
        <p class="note">Cada punt és una estació; la línia discontínua és la tendència. Quan la tendència s'inverteix, hi ha inversió tèrmica a la vall.</p>
        <a href="/historial" class="link-arrow">Veure l'historial de cada dia <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
      </div>
      <div set:html={svg} />
    </div>
  </section>
)}
