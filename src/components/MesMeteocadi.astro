---
// Portada · "Més de Meteocadí" (substitueix "Explora el cel del Cadí", 20/10/2026): l'historial (amb les màximes dels
// darrers dies i els rècords de la xarxa), quin model encerta més (quan ja n'hi ha prou dades), el darrer episodi, la
// guia per triar una estació i el cap de setmana. Cada targeta porta una dada real, calculada en compilar.
import { stationHistory, stationRecords } from '../lib/archive.js';
import { episodes } from '../lib/episodes.js';
import { verify, modelsReady } from '../lib/models.js';
import { weekendDays } from '../lib/weekend.js';
import { tempColorLight, num, dayShort, parseDay, fullDate, dayMonth, cap } from '../lib/format.js';
import { STATIONS, BY_ID, shortName } from '../lib/stations.js';

const ARROW = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>';
const ICON = {
  hist: ['M3 12a9 9 0 1 0 3-6.7L3 8', 'M3 3v5h5', 'M12 7v5l4 2'],
  models: ['M3 3v18h18', 'M7 16v2', 'M12 11v7', 'M17 6v12'],
  ep: ['M6 16.3A7 7 0 1 1 15.7 8h1.8a4.5 4.5 0 0 1 .5 9', 'm13 12-3 5h4l-3 5'],
  est: ['M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z'],
  cap: ['M8 2v4', 'M16 2v4', 'M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', 'M3 10h18'],
};
const paths = (k) => ICON[k].map((d) => '<path d="' + d + '"></path>').join('');
const icon = (k) => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + paths(k) + '</svg>';

// Historial: màximes dels darrers 7 dies a l'estació amb més dies arxivats (Bagà Nord) i els rècords de la xarxa
const REF = 'IBAG65';
const hist = stationHistory(REF).filter((d) => d.tempHigh != null).slice(0, 7).reverse();
const hv = hist.map((d) => d.tempHigh);
const lo = hv.length ? Math.floor(Math.min(...hv) - 6) : 0;
const hi = hv.length ? Math.ceil(Math.max(...hv) + 1) : 1;
const BW = 300, BH = 150;
const gap = hist.length ? BW / hist.length : 40;
const bw = Math.min(30, gap - 10);
let hot = null, cold = null;
for (const s of STATIONS) {
  const r = stationRecords(s.id);
  if (r?.maxHigh && (!hot || r.maxHigh.v > hot.v)) hot = { ...r.maxHigh, s };
  if (r?.minLow && (!cold || r.minLow.v < cold.v)) cold = { ...r.minLow, s };
}

// Models: el que ha encertat més els darrers 30 dies (temperatura, previsió del dia abans)
const v30 = modelsReady() ? verify({ n: 30 }) : null;
const best = v30?.rows?.[0];
// Darrer episodi
const ep = episodes()[0];
// Cap de setmana: "dissabte 24 i diumenge 25 d'octubre" (o "avui, diumenge 25 d'octubre")
const wk = weekendDays();
const wkText = wk.length === 1
  ? `Avui, diumenge ${dayMonth(wk[0])}`
  : parseDay(wk[0]).getUTCMonth() === parseDay(wk[1]).getUTCMonth()
    ? `Dissabte ${parseDay(wk[0]).getUTCDate()} i diumenge ${dayMonth(wk[1])}`
    : `Dissabte ${dayMonth(wk[0])} i diumenge ${dayMonth(wk[1])}`;

const smalls = (best ? 1 : 0) + (ep ? 1 : 0) + 2;
---
<section class="sec mm" id="mes">
  <div class="wrap">
    <div class="sec__head">
      <div>
        <span class="eyebrow" style="color:var(--muted);">L'ARXIU, ELS MODELS I MÉS</span>
        <h2 class="h2">Més de <em>Meteocadí</em></h2>
        <p class="sub" style="max-width:660px;">Tot el que guarden les estacions, quin model de previsió encerta més al Cadí, els episodis de mal temps i guies per al cap de setmana i per tenir la teva estació.</p>
      </div>
      <a href="/sobre" class="link-arrow">Sobre el projecte <Fragment set:html={ARROW} /></a>
    </div>
    <div class={`mm-grid${smalls % 2 ? ' mm-grid--odd' : ''}`}>
      <a href="/historial" class="mm-card mm-card--big">
        <span class="mm-ic" set:html={icon('hist')} />
        <h3>Historial i rècords</h3>
        <p>Cada nit s'arxiven la màxima, la mínima, la ratxa de vent i la pluja de totes les estacions: dia a dia, mes a mes i any a any.</p>
        {hist.length > 1 && (
          <figure class="mm-bars">
            <figcaption>Màximes a {BY_ID[REF].name}, darrers dies</figcaption>
            <svg viewBox={`0 0 ${BW} ${BH + 26}`} aria-hidden="true">
              {hist.map((d, i) => {
                const h = ((d.tempHigh - lo) / (hi - lo)) * (BH - 26);
                const x = (i + 0.5) * gap - bw / 2;
                const y = BH - h;
                return (
                  <g>
                    <rect class="a-grow" x={x.toFixed(1)} y={y.toFixed(1)} width={bw.toFixed(1)} height={h.toFixed(1)} rx="4" fill={tempColorLight(d.tempHigh)} style={`animation-delay:${(0.2 + i * 0.1).toFixed(2)}s`}></rect>
                    <text x={(x + bw / 2).toFixed(1)} y={(y - 7).toFixed(1)} text-anchor="middle" class="mm-bars__v">{num(d.tempHigh)}</text>
                    <text x={(x + bw / 2).toFixed(1)} y={BH + 20} text-anchor="middle" class="mm-bars__d">{dayShort(d.date)} {parseDay(d.date).getUTCDate()}</text>
                  </g>
                );
              })}
              <line x1="0" y1={BH + 0.5} x2={BW} y2={BH + 0.5} stroke="#c7d2de"></line>
            </svg>
          </figure>
        )}
        {(hot || cold) && (
          <dl class="mm-rec">
            {hot && <div><dt>Rècord de calor de la xarxa</dt><dd><b style={`color:${tempColorLight(hot.v)}`}>{num(hot.v)} °C</b> {shortName(hot.s)}, {fullDate(hot.date)}</dd></div>}
            {cold && <div><dt>Rècord de fred de la xarxa</dt><dd><b style={`color:${tempColorLight(cold.v)}`}>{num(cold.v)} °C</b> {shortName(cold.s)}, {fullDate(cold.date)}</dd></div>}
          </dl>
        )}
        <span class="mm-go">Obre l'historial <Fragment set:html={ARROW} /></span>
      </a>
      {best && (
        <a href="/models" class="mm-card">
          <span class="mm-ic" set:html={icon('models')} />
          <h3>Quin model encerta més</h3>
          <p>Les previsions de cada model, comparades cada dia amb el que marquen les estacions.</p>
          <span class="mm-hook"><b>{best.name}</b> · {num(best.mae, 1)}° d'error mitjà, els darrers {v30.days} dies</span>
          <span class="mm-go">Veure el rànquing <Fragment set:html={ARROW} /></span>
        </a>
      )}
      {ep && (
        <a href="/episodis" class="mm-card">
          <span class="mm-ic" set:html={icon('ep')} />
          <h3>Episodis</h3>
          <p>Pluja intensa, vent fort, calor, fred i glaçades, explicats amb les dades de la xarxa.</p>
          <span class="mm-hook"><b>{ep.label}</b> · {cap(ep.rangeText)}: {ep.headline.v} {ep.headline.u} {ep.headline.a}</span>
          <span class="mm-go">Tots els episodis <Fragment set:html={ARROW} /></span>
        </a>
      )}
      <a href="/cap-de-setmana" class="mm-card">
        <span class="mm-ic" set:html={icon('cap')} />
        <h3>Aquest cap de setmana</h3>
        <p>La previsió als pobles i als cims del Cadí, calculada per a l'altitud de cada lloc.</p>
        <span class="mm-hook"><b>{wkText}</b></span>
        <span class="mm-go">Veure la previsió <Fragment set:html={ARROW} /></span>
      </a>
      <a href="/quina-estacio-meteorologica-comprar" class="mm-card">
        <span class="mm-ic" set:html={icon('est')} />
        <h3>Quina estació comprar</h3>
        <p>Com triar una estació meteorològica per a casa o per a la muntanya, on posar-la i com compartir-ne les dades.</p>
        <span class="mm-hook"><b>Quatre recomanacions</b>, de la primera estació a una per a molts anys</span>
        <span class="mm-go">Llegeix la guia <Fragment set:html={ARROW} /></span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .mm-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .mm-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: 18px; background: var(--pale); color: var(--ink); transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease; }
  .mm-card:hover { color: var(--ink); background: #e6eef6; transform: translateY(-3px); box-shadow: 0 16px 36px rgba(16, 35, 59, 0.12); }
  .mm-card--big { grid-row: span 2; background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .mm-card--big:hover { background: #fff; box-shadow: 0 0 0 1px var(--line), 0 16px 36px rgba(16, 35, 59, 0.12); }
  .mm-grid--odd > .mm-card:last-child { grid-column: span 2; }
  .mm-ic { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: rgba(31, 111, 209, 0.12); color: var(--accent); }
  .mm-card h3 { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin-top: 4px; }
  .mm-card--big h3 { font-size: 30px; }
  .mm-card p { font-size: 15px; line-height: 1.5; color: var(--ink2); }
  .mm-hook { font-size: 14px; line-height: 1.45; color: var(--ink2); padding-top: 10px; border-top: 1px solid rgba(16, 35, 59, 0.1); }
  .mm-hook b { color: var(--ink); font-weight: 700; }
  .mm-go { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--accent); }
  .mm-bars { margin: 8px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .mm-bars figcaption { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .mm-bars svg { width: 100%; max-width: 420px; height: auto; display: block; }
  .mm-bars__v { font-family: var(--f-mono); font-size: 12px; font-weight: 600; fill: var(--ink); }
  .mm-bars__d { font-family: var(--f-ui); font-size: 11.5px; fill: var(--muted); }
  .mm-rec { display: grid; gap: 10px; margin: 6px 0 0; }
  .mm-rec div { display: flex; flex-direction: column; gap: 2px; }
  .mm-rec dt { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .mm-rec dd { margin: 0; font-size: 14.5px; color: var(--ink2); }
  .mm-rec b { font-family: var(--f-mono); font-size: 17px; font-weight: 600; margin-right: 4px; }
  @media (max-width: 1100px) {
    .mm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mm-card--big { grid-row: auto; grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .mm-grid { grid-template-columns: 1fr; gap: 14px; }
    .mm-grid--odd > .mm-card:last-child { grid-column: auto; }
  }
</style>
