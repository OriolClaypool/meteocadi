---
// Meteocadí Neu, fitxa d'una estació: el perfil amb la isoterma i la cota de neu, les xifres d'ara, el dia triat,
// la neu caiguda i la prevista, hora a hora, 7 dies, la neu mesurada a prop, allaus i enllaços oficials.
// Al build es pinta amb la previsió d'aquell moment; al navegador, amb /api/neu, /api/neu/<estació> (hora a hora)
// i /api/neu/mesurada. Mai "no tenim estació": si no hi ha cap sensor a prop, la secció no surt.
// En temporada, el dia triat porta la nota de 0 a 10 (src/lib/neu/nota.js) i les seves parts, i la tira i la taula
// dels 7 dies, la nota de cada dia. Abans que l'estació obri (src/lib/neu/temporada.js) no hi ha nota: a dalt diu
// quan obre i, si obre dins dels 7 dies, els dies d'abans surten com a "Tancada".
// Des del 27/11/2026 és un component amb l'idioma (lang) i l'estació (slug): /neu/<estació> (català) i, amb els
// mateixos textos de textos.js, el castellà. Les pàgines només el criden.
import NeuLayout from '../../layouts/NeuLayout.astro';
import { NEU_BY_SLUG, lleugera, allausOf, properes } from '../../lib/neu/estacions.js';
import { previsioBuild } from '../../lib/neu/build.js';
import { neuFor } from '../../lib/neu/neu.js';
import { notaFor, depthToday } from '../../lib/neu/nota.js';
import { isOpen, temporadaFor } from '../../lib/neu/temporada.js';
import { textos } from '../../lib/neu/textos.js';
import { PLACES_ES } from '../../lib/places-es.js';
import { inSeason } from '../../lib/ski.js';
import { todayMadrid, num } from '../../lib/format.js';

interface Props { slug: string; lang?: 'ca' | 'es' }
const { slug, lang = 'ca' } = Astro.props;
const tx = textos(lang);
const F = tx.fx;
const {
  groupsOf, todayIdx, snowSum, dayLines, profileSVG, factsHTML, verdictHTML, weekStripHTML, NOTA_LEGEND, LEVEL_LEGEND, trioHTML,
  snowChartSVG, chartLegendHTML, snowTypeHTML, weekTableHTML, weekNote, pastSnow, icon, thousands,
} = neuFor(tx);
const { notesOf } = notaFor(tx);
const { obreText } = temporadaFor(tx);

const r = NEU_BY_SLUG[slug];
const lite = lleugera(r);
const today = todayMadrid();
// Temporada per a aquesta fitxa: l'estació és oberta algun dels 7 dies de la previsió
const in6 = new Date(Date.parse(`${today}T12:00:00Z`) + 6 * 864e5).toISOString().slice(0, 10);
const season = (inSeason(today) || inSeason(in6)) && isOpen(lite, in6);
const obre = obreText(lite, today);
const fc = await previsioBuild();
const g = groupsOf([lite], fc)?.[0] ?? null;
const i0 = g ? todayIdx(g.top.days, today) : 0;
// Al build, la nota amb el gruix del model (el navegador la refà amb els sensors i el trànsit)
const notes = g && season ? notesOf(g, today) : null;
const depth = g ? depthToday(g, i0, []) : null;
const ps = g ? pastSnow(g, null, today, 5) : null;
const dl = g ? dayLines(g, i0) : { frz: null, line: null };
// Fora de temporada i sense neu els darrers dies, la muntanya surt sense neu
const cover = g && !season && snowSum(g.top.days, i0 - 5, 6) < 10 ? 'bare' : null;
const fons = r.type === 'fons';
const kind = tx.kindLow(r.type);
const cotes = `${thousands(r.base)}–${thousands(r.top)}`;
const av = allausOf(r);
const near = properes(r, 4);
const km = r.km != null ? `${num(r.km, r.km % 1 ? 1 : 0)} km` : r.kmMin != null ? F.kmMin(r.kmMin) : null;

const FT = F.facts;
const FACTS = [
  [FT.cotes, cotes, true],
  [FT.desnivell, `${thousands(r.top - r.base)} m`, true],
  [fons ? FT.circuits : FT.pistes, km, true],
  [FT.esqui, fons ? FT.deFons : FT.alpi, false],
  [FT.oberta, r.opened ? String(r.opened) : null, true],
  [FT.zona, r.zone, false],
].filter(([, v]) => v != null) as [string, string, boolean][];

const title = F.title(r.name);
// En castellà, el lloc amb la preposició de places-es.js ("en La Molina")
const description = F.desc({ ...r, aEs: PLACES_ES[r.slug]?.a ?? null }, cotes);
---
<NeuLayout
  lang={lang}
  title={title}
  description={description}
  path={`${tx.base}${r.slug}`}
  alternates={{ ca: `/neu/${r.slug}`, es: `/es/esqui/${r.slug}` }}
  current="estacions"
  back={{ href: `${tx.home}#estacions`, label: tx.pg.estacions }}
  share
  card={{ title: r.name, sub: F.cardSub(cotes), lat: r.lat, lng: r.lng, label: r.short }}
>
  <div slot="hero" data-neu-fitxa={JSON.stringify({ resort: lite, today })}>
    <h1 class="nv-name">{r.name}</h1>
    <p class="nv-meta">{r.zone} · {kind} · {cotes} m</p>
    <div class="nv-chiprow">
      <a class="nv-dchip" href={r.estat ?? r.web} rel="noopener">{r.estat ? F.estat : F.web}<Fragment set:html={icon('ext', 14)} /></a>
      {r.cams && <a class="nv-dchip" href={r.cams} rel="noopener">{F.webcams}<Fragment set:html={icon('ext', 14)} /></a>}
    </div>
    <p class="nv-open" data-nv-open hidden={!obre}><b>{F.closed}</b> <span>{obre}</span></p>
    <div class="nv-fhero">
      <div data-nv-prof set:html={profileSVG(lite, { frz: dl.frz, line: dl.line, cover, snowing: (g?.top.days[i0]?.snow ?? 0) >= 1 })} />
      <div class="nv-facts" data-nv-facts set:html={factsHTML(g, { today, depth })} />
    </div>
  </div>

  <div class="nv-in">
    <div class="nv-card nv-verd">
      <div data-nv-verd set:html={g ? verdictHTML(g, today, 0, season, notes) : `<p class="nv-load">${tx.pg.loading}</p>`} />
      <div data-nv-strip set:html={g ? weekStripHTML(g, today, 0, season, notes) : ''} />
      <div data-nv-lg hidden={!season} set:html={notes?.some((n) => n?.v != null) ? NOTA_LEGEND : LEVEL_LEGEND} />
    </div>
  </div>

  <nav class="nv-tabs" aria-label={F.ariaTabs} data-nv-tabs>
    <a href="#neu" class="is-on">{F.tabs.neu}</a>
    <a href="#hores">{F.tabs.hores}</a>
    <a href="#dies">{F.tabs.dies}</a>
    <a href="#mesurada" hidden>{F.tabs.mesurada}</a>
    <a href="#allaus">{F.tabs.allaus}</a>
    {r.roadsKm && <a href="#arribar">{F.tabs.arribar}</a>}
    <a href="#enllacos">{F.tabs.enllacos}</a>
  </nav>

  <section class="nv-sec nv-anchor" id="neu">
    <div class="nv-in">
      <h2 class="nv-h2">{F.neuT}</h2>
      <div data-nv-trio set:html={g && ps ? trioHTML(g, today, ps) : ''} />
      <div class="nv-card nv-chartbox">
        <div data-nv-chart set:html={g && ps ? snowChartSVG(g, today, ps) : `<p class="nv-load">${tx.pg.loading}</p>`} />
        <div data-nv-chartlg set:html={g && ps ? chartLegendHTML(g, today, ps) : ''} />
      </div>
      <div data-nv-type set:html={g ? snowTypeHTML(g, today, null, season, depth) : ''} />
    </div>
  </section>

  <section class="nv-sec nv-anchor" id="hores">
    <div class="nv-in">
      <h2 class="nv-h2" data-nv-hhtitle>{F.hhTitle(tx.Avui)}</h2>
      <div data-nv-hours><p class="nv-load">{F.loadingHH}</p></div>
    </div>
  </section>

  <section class="nv-sec nv-anchor" id="dies">
    <div class="nv-in">
      <h2 class="nv-h2">{F.diesT}</h2>
      <div data-nv-week set:html={g ? weekTableHTML(g, today, season, notes) : `<p class="nv-load">${tx.pg.loading}</p>`} />
      <p class="nv-note-s" data-nv-wnote>{g ? weekNote(g, today) : ''}</p>
    </div>
  </section>

  <section class="nv-sec nv-anchor" id="mesurada" hidden>
    <div class="nv-in">
      <h2 class="nv-h2">{F.mesT}</h2>
      <div data-nv-sens></div>
      <p class="nv-note-s">{F.mesNote}</p>
    </div>
  </section>

  <section class="nv-sec nv-anchor" id="allaus">
    <div class="nv-in">
      <h2 class="nv-h2">{F.allausT}</h2>
      <ul class="nv-card nv-links">
        <li>
          <a href={av.url} rel="noopener">
            <span class="nv-links__t"><span class="nv-links__k" set:html={icon('alert', 18)} /><span><b>{F.butlleti}</b><small>{av.name}</small></span></span>
            <Fragment set:html={icon('ext', 18)} />
          </a>
        </li>
      </ul>
      <p class="nv-note-s">{F.allausNote}</p>
    </div>
  </section>

  {r.roadsKm && (
    <section class="nv-sec nv-anchor" id="arribar">
      <div class="nv-in">
        <h2 class="nv-h2">{F.arribarT}</h2>
        <div class="nv-card nv-roads" data-nv-roads={`${r.lat}:${r.lng}:${r.roadsKm}`} aria-live="polite">
          <p class="nv-load">{F.loadingRoads}</p>
        </div>
        <p class="nv-note-s" set:html={F.roadsNote(r.roadsKm)} />
      </div>
    </section>
  )}

  <section class="nv-sec nv-anchor" id="enllacos">
    <div class="nv-in">
      <h2 class="nv-h2">{F.linksT}</h2>
      <ul class="nv-card nv-links">
        {r.estat && (
          <li><a href={r.estat} rel="noopener"><span><b>{F.estatOf}</b><small>{F.estatS}</small></span><Fragment set:html={icon('ext', 18)} /></a></li>
        )}
        {r.cams && (
          <li><a href={r.cams} rel="noopener"><span><b>{F.webcams}</b><small>{F.camsS}</small></span><Fragment set:html={icon('ext', 18)} /></a></li>
        )}
        <li><a href={r.web} rel="noopener"><span><b>{F.web}</b><small>{F.webS}</small></span><Fragment set:html={icon('ext', 18)} /></a></li>
      </ul>
    </div>
  </section>

  <section class="nv-sec nv-anchor" id="estacio">
    <div class="nv-in">
      <h2 class="nv-h2">{F.estacioT}</h2>
      <dl class="nv-dl">
        {FACTS.map(([k, v, mono]) => <div><dt>{k}</dt><dd class:list={[mono && 'nv-mono']}>{v}</dd></div>)}
      </dl>
      <p class="nv-note-s">{F.factsNote}</p>
      <h3 class="nv-h3 nv-near__t">{F.nearT}</h3>
      <div class="nv-near">
        {near.map((n) => <a href={`${tx.base}${n.r.slug}`}>{n.r.name} <small>{Math.round(n.km)} km</small></a>)}
      </div>
    </div>
  </section>
</NeuLayout>

<script>
  import { neuFor } from '../../lib/neu/neu.js';
  import { notaFor, depthToday, sensorsFor } from '../../lib/neu/nota.js';
  import { isOpen, temporadaFor } from '../../lib/neu/temporada.js';
  import { textos } from '../../lib/neu/textos.js';
  import { inSeason } from '../../lib/ski.js';
  import { todayMadrid } from '../../lib/format.js';

  // L'idioma de la pàgina (<html lang>): els textos i les peces de Neu en català o en castellà
  const tx = textos(document.documentElement.lang);
  const F = tx.fx;
  const {
    groupsOf, todayIdx, snowSum, dayLines, profileSVG, factsHTML, verdictHTML, weekStripHTML, trioHTML, snowChartSVG,
    chartLegendHTML, snowTypeHTML, weekTableHTML, weekNote, pastSnow, nearSensors, nowHour, hoursHTML, hoursDay, sensorsHTML,
    NOTA_LEGEND, LEVEL_LEGEND, setMeasured,
  } = neuFor(tx);
  const { notesOf } = notaFor(tx);
  const { obreText } = temporadaFor(tx);

  const root = document.querySelector<HTMLElement>('[data-neu-fitxa]')!;
  const { resort } = JSON.parse(root.dataset.neuFitxa || '{}');
  const q = new URLSearchParams(location.search);
  let today = todayMadrid();
  // ?temporada (per fer proves): com si fos temporada i l'estació fos oberta
  const forced = q.has('temporada');
  if (forced) { delete resort.obre; delete resort.obreDes; }
  const in6 = () => new Date(Date.parse(`${today}T12:00:00Z`) + 6 * 864e5).toISOString().slice(0, 10);
  // Temporada per a aquesta fitxa: l'estació és oberta algun dels 7 dies de la previsió
  const season = () => forced || ((inSeason(today) || inSeason(in6())) && isOpen(resort, in6()));
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s);
  const set = (s: string, html: string) => { const el = $(s); if (el) el.innerHTML = html; };

  // fc: previsió diària (/api/neu); hr: hora a hora (/api/neu/<estació>); st: sensors (/api/neu/mesurada)
  // undefined = encara no ha arribat; null = no ha arribat i no arribarà en aquesta càrrega
  let fc: any = undefined;
  let hr: any = undefined;
  let st: any[] | null | undefined = undefined;
  // tr: incidències de l'SCT a prop (les de "Com arribar"; compten per a la nota d'avui)
  let tr: any[] | null = null;
  let sel = 0;

  // El grup porta la neu nova mesurada al sensor més proper (setMeasured): les frases del dia diuen la mateixa
  // xifra que el gràfic
  const group = () => {
    const g = groupsOf([resort], fc)?.[0] ?? null;
    return g ? setMeasured(g, nearSensors(resort, st, 3)) : null;
  };
  // Les 7 notes de l'estació (en temporada)
  const notesNow = (g: any) => (g && season() ? notesOf(g, today, { stations: st ?? null, transit: tr }) : null);

  function paintTop(g: any, sensors: any[], now: any) {
    if (!g) return;
    const i0 = todayIdx(g.top.days, today);
    const i = i0 + sel;
    const dl = dayLines(g, i);
    // Avui: la isoterma de l'hora actual i la cota de neu que en surt; els altres dies, la del dia
    const frz = sel === 0 && now?.top?.frz != null ? now.top.frz : dl.frz;
    const line = dl.line != null && frz != null ? Math.max(0, Math.round((frz - 300) / 100) * 100) : dl.line;
    const s = sensors[0];
    const cover = s?.now != null ? (s.now >= 5 ? 'snow' : s.now === 0 ? 'bare' : null) : !season() && snowSum(g.top.days, i0 - 5, 6) < 10 ? 'bare' : null;
    const snowing = sel === 0 ? (now?.top?.snow ?? 0) > 0.05 || (now == null && (g.top.days[i]?.snow ?? 0) >= 1) : (g.top.days[i]?.snow ?? 0) >= 1;
    set('[data-nv-prof]', profileSVG(resort, { frz, line, cover, snowing, now: sel === 0 ? now : null }));
    const notes = notesNow(g);
    set('[data-nv-verd]', verdictHTML(g, today, sel, season(), notes));
    set('[data-nv-strip]', weekStripHTML(g, today, sel, season(), notes));
    set('[data-nv-lg]', notes?.some((n: any) => n?.v != null) ? NOTA_LEGEND : LEVEL_LEGEND);
    $('[data-nv-lg]')!.hidden = !season();
  }

  function paint() {
    today = todayMadrid();
    const g = group();
    const sensors = nearSensors(resort, st, 3);
    const now = nowHour(hr);
    // Sense previsió al build ni ara: es diu a cada lloc on s'esperava (la del build, si n'hi ha, es queda)
    const failed = !g && fc === null && !!$('[data-nv-verd] .nv-load');
    if (failed) document.querySelectorAll('[data-nv-verd] .nv-load, [data-nv-chart] .nv-load, [data-nv-week] .nv-load').forEach((el) => (el.textContent = tx.pg.fcFail));
    paintTop(g, sensors, now);
    // El gruix de l'estació, el mateix de la nota (amb els sensors quan arriben)
    const depth = g ? depthToday(g, todayIdx(g.top.days, today), sensorsFor(resort, st ?? null)) : null;
    const ob = obreText(resort, today);
    $('[data-nv-open]')!.hidden = !ob;
    if (ob) $('[data-nv-open] span')!.textContent = ob;
    if (fc !== undefined && (g || !$('[data-nv-facts] .nv-fact__v small'))) set('[data-nv-facts]', factsHTML(g, { today, now, sensors, wait: hr === undefined || st === undefined, depth }));
    if (g) {
      const ps = pastSnow(g, sensors, today, 5);
      set('[data-nv-trio]', trioHTML(g, today, ps));
      set('[data-nv-chart]', snowChartSVG(g, today, ps));
      set('[data-nv-chartlg]', chartLegendHTML(g, today, ps));
      set('[data-nv-type]', snowTypeHTML(g, today, sensors, season(), depth));
      set('[data-nv-week]', weekTableHTML(g, today, season(), notesNow(g)));
      $('[data-nv-wnote]')!.textContent = weekNote(g, today);
    }
    // Hora a hora: avui o, a partir de les 17 h, demà. Si no arriba, la secció no surt
    const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
    const hh = hr ? hoursDay(hr, today, hour) : null;
    const hhHTML = hh ? hoursHTML(hr, hh.date) : '';
    if (hhHTML) { set('[data-nv-hours]', hhHTML); $('[data-nv-hhtitle]')!.textContent = F.hhTitle(hh!.word); }
    const hideHours = hr === null || (hr !== undefined && !hhHTML);
    $('#hores')!.hidden = hideHours;
    $('[data-nv-tabs] a[href="#hores"]')!.hidden = hideHours;
    // Neu mesurada: només si hi ha algun sensor a prop
    const sens = sensorsHTML(sensors);
    if (sens) set('[data-nv-sens]', sens);
    $('#mesurada')!.hidden = !sens;
    $('[data-nv-tabs] a[href="#mesurada"]')!.hidden = !sens;
  }

  // Per provar fora de temporada: ?temporada passa als enllaços de Neu
  if (q.has('temporada')) {
    document.querySelectorAll<HTMLAnchorElement>(`a[href^="${tx.home}"]`).forEach((a) => {
      const u = new URL(a.href, location.href);
      if (!u.searchParams.has('temporada')) a.href = `${u.pathname}?temporada${u.hash}`;
    });
  }

  // Dia triat a la tira dels 7 dies
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-nv-strip] [data-k]');
    if (!b) return;
    sel = Number(b.dataset.k);
    const g = group();
    if (g) paintTop(g, nearSensors(resort, st, 3), nowHour(hr));
  });

  // Pestanyes: la secció que es veu queda marcada
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nv-tabs] a'));
  if ('IntersectionObserver' in window) {
    const vis = new Map<string, boolean>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => vis.set(e.target.id, e.isIntersecting));
      const on = tabs.find((a) => vis.get(a.hash.slice(1)) && !a.hidden);
      if (on) tabs.forEach((a) => a.classList.toggle('is-on', a === on));
    }, { rootMargin: '-60px 0px -55% 0px' });
    tabs.forEach((a) => { const s = document.getElementById(a.hash.slice(1)); if (s) io.observe(s); });
  }

  const getJson = (u: string) => fetch(u).then((r) => (r.ok ? r.json() : Promise.reject(new Error(`${u} ${r.status}`))));

  // Com arribar: incidències del Servei Català de Trànsit a prop de l'estació
  const roadsBox = $('[data-nv-roads]');
  const escH = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
  const SMALL = new Set(['de', 'del', 'dels', 'la', 'el', 'les', 'els', 'i', 'a']);
  const capW = (s: string) => String(s || '').toLowerCase().replace(/[^\s\-'’]+/g, (w, i) => (i > 0 && SMALL.has(w) ? w : w[0].toUpperCase() + w.slice(1))).replace(/\b(D|L)'/g, (m, c, i) => (i > 0 ? c.toLowerCase() + "'" : m));
  const pk = (v: number | null) => (v == null ? '' : String(v).replace('.', ','));
  function loadRoads() {
    if (!roadsBox) return;
    getJson(`/api/transit?near=${roadsBox.dataset.nvRoads}`)
      .then((j) => {
        if (j.error) throw new Error('sct');
        // Per a la nota d'avui (neu o gel a les carreteres)
        tr = j.items ?? [];
        paint();
        if (!j.items?.length) { roadsBox.innerHTML = F.roadsOk; return; }
        roadsBox.innerHTML = j.items.map((it: any) => {
          const t = `${it.type} ${it.text} ${it.cause}`.toLowerCase();
          const cls = /tallad|tancad/.test(t) ? 'is-red' : /cadenes|neu|gel|glaç/.test(t) ? 'is-amber' : '';
          const tram = it.pkFrom != null ? ` · km ${pk(it.pkFrom)}${it.pkTo != null && it.pkTo !== it.pkFrom ? `–${pk(it.pkTo)}` : ''}` : '';
          const cap_a = it.towards ? F.towards(escH(capW(it.towards))) : '';
          return `<p class="nv-road ${cls}"><i></i><span><b>${escH(it.road)}${tram}</b>${escH(it.text)}${it.cause ? ` (${escH(String(it.cause).toLowerCase())})` : ''}${cap_a}</span></p>`;
        }).join('');
      })
      .catch(() => { roadsBox.innerHTML = `<p class="nv-load">${F.roadsFail}</p>`; });
  }
  loadRoads();
  setInterval(loadRoads, 10 * 60 * 1000);

  function load() {
    getJson('/api/neu')
      .then((j) => { fc = j?.resorts?.[resort.slug] ? j : (fc ?? null); })
      .catch(() => { fc = fc ?? null; })
      .finally(paint);
    getJson(`/api/neu/${resort.slug}`)
      .then((j) => { hr = j?.hours?.length ? j : (hr ?? null); })
      .catch(() => { hr = hr ?? null; })
      .finally(paint);
    getJson('/api/neu/mesurada')
      .then((j) => { st = j?.error ? (st ?? null) : (j?.stations ?? null); })
      .catch(() => { st = st ?? null; })
      .finally(paint);
  }
  load();
  setInterval(load, 30 * 60 * 1000);
</script>
