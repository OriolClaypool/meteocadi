---
// Icones de traç animades del resum (estil A)
interface Props { name: 'up' | 'down' | 'wind' | 'drop'; color?: string }
const { name, color = '#3db8ff' } = Astro.props;
const up = name === 'up';
---
{(name === 'up' || name === 'down') && (
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M8.5 14.2V5.5a2.5 2.5 0 0 1 5 0v8.7a4.5 4.5 0 1 1-5 0z" stroke="#7d8fa6" stroke-width="1.5"></path>
    <circle cx="11" cy="17.9" r="2.1" fill={color}></circle>
    <path class="ic-merc" d={up ? 'M11 16V9' : 'M11 16v-3.5'} stroke={color} stroke-width="2"></path>
    <path class="ic-bob" d={up ? 'M19 10V4M16.6 6.4 19 4l2.4 2.4' : 'M19 4v6M16.6 7.6 19 10l2.4-2.4'} stroke={color} stroke-width="1.8"></path>
  </svg>
)}
{name === 'wind' && (
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path class="ic-wind" d="M3 8.5h9.5a2.5 2.5 0 1 0-2.5-2.5"></path>
    <path class="ic-wind" d="M3 12.5h14.5a2.5 2.5 0 1 1-2.5 2.5" style="animation-delay:-0.6s"></path>
    <path class="ic-wind" d="M3 16.5h7" style="animation-delay:-1.1s"></path>
  </svg>
)}
{name === 'drop' && (
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path class="ic-drop" d="M12 3.5c3.2 4.1 5.5 7.1 5.5 10a5.5 5.5 0 0 1-11 0c0-2.9 2.3-5.9 5.5-10z" stroke="#60a5fa" stroke-width="1.7" fill="#60a5fa" fill-opacity="0.15" stroke-linejoin="round"></path>
  </svg>
)}
