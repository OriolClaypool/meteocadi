---
// Estudi: eina interna (no indexada) per fer les imatges verticals de xarxes.
// Previsió (text propi), Resum del dia i Rànquing (dades de l'arxiu o d'avui en directe). El rànquing també es pot
// fer amb les estacions del Meteocat de tot Catalunya (les 10 primeres). El rànquing surt en 4:5, 9:16 o 16:9.
import Base from '../layouts/Base.astro';
import { WEATHER } from '../scripts/estudi/draw.js';
import EstudiTop from '../components/EstudiTop.astro';
---
<Base
  title="Estudi d'imatges | Meteocadí"
  description="Eina interna de Meteocadí per preparar les imatges de xarxes."
  path="/estudi"
  noindex
  bare
>
  <div class="st">
    <EstudiTop current="app" />
    <nav class="st-mnav" aria-label="Vista"><button class="on" data-view="edit">Editar</button><button data-view="preview">Previsualitzar</button></nav>

    <main class="st-work">
      <section class="st-ed" aria-label="Opcions de la imatge">
        <!-- ============ PREVISIÓ ============ -->
        <div data-panel="previsio">
          <div class="st-edhead">
            <div><p class="st-eyebrow">EL TEU BUTLLETÍ</p><h1>La previsió</h1></div>
            <button class="st-btn st-btn--quiet" id="pasteOpen" type="button">Enganxar text</button>
          </div>
          <div class="st-row"><label for="pvDate">Data</label><input id="pvDate" type="date" /></div>
          <div class="st-daytabs" role="tablist" aria-label="Apartat">
            <button data-day="0" aria-selected="true">Avui</button>
            <button data-day="1" aria-selected="false">Demà</button>
            <button data-day="2" aria-selected="false">Pròxims dies</button>
          </div>
          <div id="dayPanel">
            <div class="st-field"><label for="headline">El titular <span>Opcional</span></label><textarea id="headline" class="st-headline" rows="2" maxlength="110" placeholder="Què destacaríem del dia?"></textarea></div>
            <div class="st-field"><label for="forecast">La previsió <span id="textCount"></span></label><textarea id="forecast" rows="5" placeholder="Explica com evolucionarà el temps…"></textarea></div>
            <div class="st-field">
              <label id="wLabel">El temps</label>
              <div class="st-seg" role="group" aria-labelledby="wLabel"><button id="modeSummary" type="button" aria-pressed="true">Tot el dia</button><button id="modeSplit" type="button" aria-pressed="false">Matí i tarda</button></div>
              <div class="st-slots" id="slotChooser" hidden><button type="button" data-slot="morning" class="on">Matí</button><button type="button" data-slot="afternoon">Tarda</button></div>
              <div class="st-wgrid" id="weatherGrid" role="group" aria-label="Símbol">
                {Object.entries(WEATHER).map(([k, label]) => (
                  <button type="button" class="st-wbtn" data-weather={k} aria-pressed="false"><img src={`/imatges/estudi/${k}.svg`} alt="" width="34" height="34" /><span>{label}</span></button>
                ))}
              </div>
            </div>
            <div class="st-field">
              <label for="alertLevel">Avís</label>
              <div class="st-alert">
                <select id="alertLevel"><option value="none">Sense avís</option><option value="groc">Groc</option><option value="taronja">Taronja</option><option value="vermell">Vermell</option></select>
                <select id="alertType" aria-label="Fenomen" hidden><option value="pluja">Pluja</option><option value="tempesta">Tempesta</option><option value="neu">Neu</option><option value="vent">Vent</option><option value="calor">Calor</option><option value="fred">Fred</option></select>
              </div>
            </div>
          </div>
          <div id="summaryPanel" hidden>
            <div class="st-field"><label for="summary">La tendència <span>Opcional</span></label><textarea id="summary" rows="7" placeholder="Quin temps s'entreveu més endavant?"></textarea><p class="st-note">Aquest bloc només surt a la imatge si hi escrius.</p></div>
          </div>
          <div class="st-edfoot"><button id="copyOpen" class="st-link" type="button">Copiar la previsió en text</button><button id="newForecast" class="st-link st-link--mut" type="button">Nova previsió</button></div>
        </div>

        <!-- ============ RESUM I RÀNQUING ============ -->
        <div data-panel="resum ranquing" hidden>
          <div class="st-edhead"><div><p class="st-eyebrow">DADES DE LA XARXA</p><h1 id="dataTitle">Resum del dia</h1></div></div>
          <div class="st-field" data-panel="ranquing" hidden>
            <label>Quines estacions</label>
            <div class="st-seg" id="rankNet"><button type="button" data-net="mc" aria-pressed="true">Xarxa Meteocadí</button><button type="button" data-net="cat" aria-pressed="false">Tot Catalunya</button></div>
          </div>
          <div class="st-field">
            <label>Quin dia</label>
            <div class="st-seg" id="dayChoice"><button type="button" data-choice="ahir" aria-pressed="true">Ahir</button><button type="button" data-choice="avui" aria-pressed="false">Avui fins ara</button><button type="button" data-choice="24h" aria-pressed="false" hidden>24 hores</button><button type="button" data-choice="altre" aria-pressed="false">Un altre dia</button><button type="button" data-choice="range" aria-pressed="false" hidden>Diversos dies</button></div>
            <input id="otherDate" type="date" hidden />
            <div class="st-range" id="rangeBox" hidden>
              <label>Del <input id="rangeFrom" type="date" /></label>
              <label>al <input id="rangeTo" type="date" /></label>
              <div class="st-range__q"><button type="button" data-range="3">3 dies</button><button type="button" data-range="7">7 dies</button><button type="button" data-range="30">30 dies</button></div>
            </div>
            <p class="st-note" id="dayNote"></p>
          </div>
          <div data-panel="ranquing" hidden>
            <div class="st-field">
              <label>Què vols classificar</label>
              <div class="st-seg st-seg--4" id="rankVar"><button type="button" data-var="ara" aria-pressed="false" title="Temperatura ara (la darrera lectura)">Temp. ara</button><button type="button" data-var="max" aria-pressed="true">Màximes</button><button type="button" data-var="min" aria-pressed="false">Mínimes</button><button type="button" data-var="pluja" aria-pressed="false">Pluja</button><button type="button" data-var="ratxa" aria-pressed="false">Ratxes</button></div>
              <div class="st-seg" id="rankOrder" style="margin-top:8px;" hidden><button type="button" data-order="calor" aria-pressed="true">Més calor primer</button><button type="button" data-order="fred" aria-pressed="false">Més fred primer</button></div>
            </div>
            <div class="st-field">
              <label>Format</label>
              <div class="st-seg" id="rankFmt"><button type="button" data-fmt="post" aria-pressed="false">Publicació 4:5</button><button type="button" data-fmt="story" aria-pressed="true">Història 9:16</button><button type="button" data-fmt="wide" aria-pressed="false">Horitzontal 16:9</button></div>
            </div>
            <div class="st-field"><label for="sentence">La frase de sota el títol <span>Es pot editar</span></label><textarea id="sentence" rows="3"></textarea><button type="button" class="st-link" id="sentenceReset" style="margin-top:6px;">Tornar a la frase automàtica</button></div>
          </div>
          <p class="st-note" id="dataNote">Les dades de cada dia es desen cada matí cap a les 6. Les estacions amb el dia incomplet no entren als extrems ni al rànquing de temperatures.</p>
        </div>
      </section>

      <section class="st-pv" aria-label="Previsualització">
        <div class="st-canvas"><canvas id="poster" width="1080" height="1920" role="img" aria-label="Previsualització de la imatge"></canvas></div>
        <div class="st-pvbar">
          <div class="st-pages" id="pageControls" hidden><button id="prevPage" type="button" aria-label="Imatge anterior">‹</button><span id="pageNumber">1 / 1</span><button id="nextPage" type="button" aria-label="Imatge següent">›</button></div>
          <span class="st-size">1080 × 1920 px · PNG</span>
          <button class="st-btn st-btn--primary" id="download" type="button" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5"></path></svg>Descarregar</button>
          <button class="st-btn st-btn--quiet" id="share" type="button" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 15V3m-4 4 4-4 4 4M6 11H5v10h14V11h-1"></path></svg>Compartir</button>
        </div>
        <p class="st-status" id="status" role="status"></p>
      </section>
    </main>
    <dialog id="pasteDialog" class="st-dialog"><form method="dialog"><div class="st-dhead"><h2>Enganxa la previsió</h2><button class="st-x" value="cancel" aria-label="Tancar">×</button></div><p>Enganxa el text amb els apartats «Avui», «Demà» i «Pròxims dies», cada títol en una línia.</p><textarea id="pasteText" rows="10" placeholder={'Avui\n…\n\nDemà\n…\n\nPròxims dies\n…'}></textarea><p id="pasteError" class="st-err" role="alert"></p><div class="st-dact"><button value="cancel" class="st-btn st-btn--quiet">Cancel·lar</button><button id="pasteApply" type="button" class="st-btn st-btn--primary">Repartir als tres blocs</button></div></form></dialog>
    <dialog id="copyDialog" class="st-dialog"><form method="dialog"><div class="st-dhead"><h2>Copia la previsió</h2><button class="st-x" value="cancel" aria-label="Tancar">×</button></div><div class="st-seg"><button type="button" id="copyPlain" aria-pressed="true">Sense emoticones</button><button type="button" id="copyEmoji" aria-pressed="false">Amb emoticones</button></div><textarea id="copyText" rows="12" readonly></textarea><div class="st-dact"><button type="button" id="copyButton" class="st-btn st-btn--primary">Copiar text</button></div></form></dialog>
    <div class="st-toast" id="toast" role="status" hidden><span></span><button id="undo" type="button" hidden>Desfer</button></div>
  </div>



  <script>
    import { startEstudi } from '../scripts/estudi/app.js';
    startEstudi();
  </script>
</Base>

<style is:global>
  .st-mnav { display: none; }
  .st-work { display: grid; grid-template-columns: 440px minmax(0, 1fr); max-width: 1500px; margin: 0 auto; min-height: calc(100vh - 72px); }
  .st-ed { background: #fff; border-right: 1px solid var(--line); padding: 30px 32px 28px; }
  .st-edhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 22px; }
  .st-eyebrow { font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.14em; color: var(--acc); margin-bottom: 6px; }
  .st h1 { font-family: var(--f-head); font-size: 32px; font-weight: 800; letter-spacing: -0.03em; }
  .st-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; font-size: 14px; color: var(--mut); }
  .st input[type='date'] { padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: #f7f9fb; color: var(--ink); }
  .st-daytabs { display: flex; gap: 22px; border-bottom: 1px solid var(--line); margin-bottom: 22px; }
  .st-daytabs button { position: relative; border: 0; background: none; padding: 10px 0; color: var(--mut); font-weight: 600; cursor: pointer; }
  .st-daytabs button[aria-selected='true'] { color: var(--acc); }
  .st-daytabs button[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; border-radius: 2px; background: var(--acc); }
  .st-field { margin-bottom: 22px; }
  .st-field > label { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; font-weight: 600; font-size: 15px; }
  .st-field > label span { font-weight: 400; font-size: 13px; color: var(--mut); }
  .st textarea { display: block; width: 100%; resize: vertical; border: 1px solid #d6dfe8; border-radius: 9px; background: #fcfdfe; padding: 11px 12px; font-size: 16px; line-height: 1.5; color: var(--ink); }
  .st textarea:focus { border-color: var(--acc); background: #fff; outline: none; }
  .st-headline { font-weight: 700; font-size: 19px !important; }
  .st-seg { display: flex; gap: 4px; padding: 4px; border-radius: 9px; background: #eef3f8; }
  .st-seg[hidden] { display: none; }
  .st-seg button { flex: 1; border: 0; background: none; border-radius: 6px; padding: 8px 8px; color: var(--mut); font-size: 14px; cursor: pointer; }
  .st-seg button[aria-pressed='true'] { background: #fff; color: var(--ink); font-weight: 600; box-shadow: 0 1px 4px rgba(16, 35, 59, 0.1); }
  .st-slots { display: flex; gap: 16px; margin: 12px 0 0; }
  .st-slots button { border: 0; border-bottom: 2px solid transparent; background: none; padding: 4px; color: var(--mut); cursor: pointer; font-size: 14px; }
  .st-slots button.on { border-color: var(--acc); color: var(--acc); font-weight: 600; }
  .st-wgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; margin-top: 12px; }
  .st-wbtn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-height: 70px; border: 1px solid var(--line); border-radius: 9px; background: #0b1524; color: #c3cfde; font-size: 13px; cursor: pointer; }
  .st-wbtn img { width: 34px; height: 34px; }
  .st-wbtn:hover { border-color: #9fb4c9; }
  .st-wbtn[aria-pressed='true'] { border-color: var(--acc); box-shadow: inset 0 0 0 2px var(--acc); color: #fff; font-weight: 600; }
  .st-alert { display: flex; gap: 8px; }
  .st-alert select { flex: 1; min-width: 0; padding: 9px 10px; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--ink); }
  .st-note { font-size: 13px; line-height: 1.5; color: var(--mut); margin-top: 8px; }
  .st-edfoot { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); padding-top: 14px; margin-top: 24px; }
  .st-link { border: 0; background: none; padding: 4px 0; color: var(--acc); font-weight: 600; font-size: 14px; cursor: pointer; }
  .st-link--mut { color: var(--mut); font-weight: 400; }
  .st-btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 10px 18px; border-radius: 9px; border: 1px solid transparent; font-weight: 600; font-size: 15px; cursor: pointer; }
  .st-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .st-btn--primary { background: var(--ink); color: #fff; }
  .st-btn--primary:hover { background: #1b3a5e; }
  .st-btn--quiet { background: #fff; border-color: var(--line); color: var(--ink); }
  .st-pv { background: #e7edf3; padding: 28px 32px; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .st-canvas.is-wide { width: min(100%, 760px); }
  .st-canvas.is-post { width: min(100%, 520px); }
  #dayChoice button { padding: 8px 4px; }
  .st-range { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin-top: 10px; }
  .st-range label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--mut); }
  .st-range input { height: 38px; border: 1px solid var(--line); border-radius: 8px; padding: 0 8px; background: #fff; color: var(--ink); }
  .st-range__q { display: inline-flex; gap: 4px; }
  .st-range__q button { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 6px 12px; font-weight: 600; font-size: 13px; color: var(--ink); cursor: pointer; }
  .st-canvas { width: min(100%, 420px); border-radius: 6px; overflow: hidden; box-shadow: 0 18px 60px rgba(16, 35, 59, 0.18), 0 2px 6px rgba(16, 35, 59, 0.12); background: #060a12; }
  .st-canvas canvas { display: block; width: 100%; height: auto; }
  .st-pvbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 14px; }
  .st-size { font-size: 13px; color: var(--mut); }
  .st-pages { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .st-pages button { width: 34px; height: 34px; border: 1px solid #c9d5e1; background: #fff; border-radius: 6px; font-size: 22px; line-height: 1; cursor: pointer; }
  .st-pages button:disabled { opacity: 0.4; }
  .st-status { font-size: 14px; color: #7a5b12; text-align: center; max-width: 440px; }
  .st-status:empty { display: none; }
  .st-dialog { border: 1px solid var(--line); border-radius: 14px; width: min(560px, calc(100vw - 28px)); padding: 24px; color: var(--ink); }
  .st-dialog::backdrop { background: rgba(6, 20, 34, 0.45); }
  .st-dhead { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .st-dhead h2 { font-family: var(--f-head); font-size: 24px; font-weight: 800; }
  .st-dialog p { font-size: 15px; color: var(--mut); margin-bottom: 14px; }
  .st-dialog textarea { width: 100%; margin-top: 12px; border: 1px solid #d6dfe8; border-radius: 9px; padding: 11px 12px; font-size: 15px; }
  .st-x { border: 0; background: none; font-size: 28px; color: var(--mut); cursor: pointer; }
  .st-err { color: #a53636 !important; margin-top: 8px; }
  .st-dact { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
  .st-toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 20; display: flex; align-items: center; gap: 18px; padding: 12px 18px; background: var(--ink); color: #fff; border-radius: 10px; font-size: 15px; box-shadow: 0 6px 22px rgba(8, 24, 39, 0.25); max-width: calc(100% - 28px); }
  .st-toast button { border: 0; background: none; color: #9fd8ff; font-weight: 700; cursor: pointer; }
  @media (max-width: 900px) {
    .st-mnav { display: flex; gap: 6px; padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
    .st-mnav button { flex: 1; min-height: 40px; border: 0; border-radius: 8px; background: #eef3f8; color: var(--mut); font-weight: 600; }
    .st-mnav button.on { background: var(--ink); color: #fff; }
    .st-work { display: block; }
    .st-ed { border-right: 0; padding: 22px 16px; }
    .st-pv { display: none; padding: 18px 16px 28px; }
    .st.is-preview .st-ed { display: none; }
    .st.is-preview .st-pv { display: flex; }
  }
</style>
