---
// Condicions a la muntanya: estacions altes en directe, previsió als cims i estacions d'esquí, i avís de responsabilitat.
import Base from '../layouts/Base.astro';
import MountainNotice from '../components/MountainNotice.astro';
import { MOUNTAINS } from '../lib/places.js';
import { STATIONS, BY_ID, fmtAlt, shortName } from '../lib/stations.js';
import { fetchMountain, summitsTableHTML } from '../lib/mountain.js';

const HIGH = STATIONS.filter((s) => s.group === 'alta');
// Un punt per lloc: el cim, o la base a les estacions d'esquí (el cim de la Tosa ja té la seva fila)
const rows = MOUNTAINS.map((p) => ({ place: p, point: p.kind === 'esqui' ? p.points[p.points.length - 1] : p.points[0] }));
const points = rows.map((r) => r.point);
const places = rows.map((r) => ({ slug: r.place.slug, name: r.place.name }));
const data = await fetchMountain(points);
const table = summitsTableHTML(data, places);
const KIND = { cim: 'Cim', coll: 'Coll', esqui: "Estació d'esquí", refugi: 'Refugi' };

const ld = [
  {
    '@type': 'ItemList',
    name: "El temps a la muntanya del Cadí-Moixeró i la Tosa d'Alp",
    itemListElement: MOUNTAINS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `El temps ${p.a}`, url: `https://www.meteocadi.cat/temps/${p.slug}` })),
  },
];
---
<Base
  title="Condicions a la muntanya: Cadí, Pedraforca, la Tosa, la Molina i Masella | Meteocadí"
  description="Vent, temperatura i sensació tèrmica en directe a les estacions altes del Cadí-Moixeró, i previsió per altitud als cims i estacions d'esquí: Pedraforca, Comabona, Tosa d'Alp, la Molina, Masella i més."
  path="/muntanya"
  jsonLd={ld}
  current="muntanya"
>
  <section class="phead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Ruta"><a href="/">Inici</a><span>›</span><span>Muntanya</span></nav>
      <h1>Condicions a la muntanya <em>del Cadí-Moixeró</em></h1>
      <p>Les quatre estacions més altes de la xarxa en directe, de 1.650 a 2.440 m, i la previsió calculada per a l'altitud de cada cim, coll i estació d'esquí de la zona.</p>
      <div style="margin-top:22px;max-width:900px;"><MountainNotice short /></div>
    </div>
  </section>

  <section class="sec sec--dark" style="padding:64px 0;">
    <div class="wrap">
      <div class="sec__head">
        <div>
          <span class="eyebrow">EN DIRECTE · ESTACIONS D'ALTA MUNTANYA</span>
          <h2 class="h2">Ara <em>a dalt</em></h2>
        </div>
        <span class="mcards__upd" data-mh-upd></span>
      </div>
      <div class="mcards">
        {HIGH.map((s) => (
          <a class="mcard" href={`/estacions/${s.slug}`} data-mh={s.id}>
            <span class="mcard__n">{shortName(s)}<small>{fmtAlt(s.alt)}</small></span>
            <span class="mcard__t" data-mh-f="temp">—</span>
            <span class="mcard__row"><span>Sensació tèrmica</span><b data-mh-f="feels">—</b></span>
            <span class="mcard__row"><span>Vent</span><b data-mh-f="wind">—</b></span>
            <span class="mcard__row"><span>Ratxa màxima d'avui</span><b data-mh-f="gust">—</b></span>
            <span class="mcard__row"><span>Màx. / mín. d'avui</span><b data-mh-f="mm">—</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="mfc" data-sum={JSON.stringify({ points, places })}>
        <div class="sec__head">
          <div>
            <span class="eyebrow">PREVISIÓ PER ALTITUD · 3 DIES</span>
            <h2 class="h2">Previsió als cims <em>i a les pistes</em></h2>
            <p class="sub">Mínima i màxima, ratxa màxima i neu prevista a l'altitud de cada lloc. Toca un lloc per veure'n el detall.</p>
          </div>
        </div>
        <div class="tscroll" data-sum-table set:html={table || '<p class="mfc__load">Carregant la previsió…</p>'}></div>
        <p class="mfc__note">Font: Open-Meteo. El vent és el del model a 10 m del terra: als cims i carenes exposades pot ser més fort.</p>
      </div>
    </div>
  </section>

  <section class="sec sec--pale">
    <div class="wrap">
      <h2 class="h2" style="font-size:34px;margin-bottom:20px;">Tots els llocs <em>de muntanya</em></h2>
      <div class="mplaces">
        {MOUNTAINS.map((p) => (
          <a class="mplace" href={`/temps/${p.slug}`}>
            <span class="mplace__k">{KIND[p.kind]}</span>
            <span class="mplace__n">{p.name}</span>
            <span class="mplace__a mono">{p.points.map((x) => fmtAlt(x.alt)).join(' · ')}</span>
            <span class="mplace__s">Estació de referència: {shortName(BY_ID[p.stations[0]])}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" style="padding:56px 0 72px;">
    <div class="wrap"><MountainNotice /></div>
  </section>
</Base>

<script>
  import { loadAra } from '../scripts/live.js';
  import { num, dirLabel, hourMadrid, tempColor } from '../lib/format.js';
  import { fetchMountain, summitsTableHTML } from '../lib/mountain.js';

  async function paintHigh() {
    const j = await loadAra(true);
    if (!j) return;
    document.querySelectorAll<HTMLElement>('[data-mh]').forEach((card) => {
      const d = j.stations?.[card.dataset.mh || ''];
      const f = (k: string) => card.querySelector<HTMLElement>(`[data-mh-f="${k}"]`);
      if (!d || d.stale) {
        f('temp')!.textContent = 'Sense dades';
        return;
      }
      const feels = d.temp != null && d.temp < 10 ? d.windchill : d.heatindex;
      f('temp')!.textContent = d.temp == null ? '—' : `${num(d.temp)}°`;
      f('temp')!.style.color = tempColor(d.temp);
      f('feels')!.textContent = feels == null ? '—' : `${num(feels)}°`;
      f('wind')!.textContent = d.wind == null ? '—' : `${num(d.wind, 0)} km/h ${dirLabel(d.dir)}`.trim();
      f('gust')!.textContent = d.gustMax == null ? '—' : `${num(d.gustMax, 0)} km/h`;
      f('mm')!.textContent = d.max == null ? '—' : `${num(d.max)}° / ${num(d.min)}°`;
    });
    const upd = document.querySelector('[data-mh-upd]');
    if (upd && j.updated) upd.textContent = `Actualitzat a les ${hourMadrid(new Date(j.updated))}`;
  }
  paintHigh();
  setInterval(paintHigh, 10 * 60 * 1000);

  const sum = document.querySelector<HTMLElement>('[data-sum]');
  if (sum) {
    const { points, places } = JSON.parse(sum.dataset.sum || '{}');
    fetchMountain(points, 3, 10000).then((data) => {
      const html = summitsTableHTML(data, places);
      const box = sum.querySelector('[data-sum-table]');
      if (html && box) box.innerHTML = html;
    });
  }
</script>
