---
// El temps a cada lloc i a cada zona (català). La versió en castellà és a /es/tiempo/[slug].
import PlacePage from '../../components/PlacePage.astro';
import RegionPage from '../../components/RegionPage.astro';
import { PLACES } from '../../lib/places.js';
import { REGIONS } from '../../lib/regions.js';

export function getStaticPaths() {
  return [
    ...PLACES.map((p) => ({ params: { slug: p.slug }, props: { region: false } })),
    ...REGIONS.map((r) => ({ params: { slug: r.slug }, props: { region: true } })),
  ];
}
const { region } = Astro.props;
---
{region ? <RegionPage slug={Astro.params.slug} lang="ca" /> : <PlacePage slug={Astro.params.slug} lang="ca" />}
