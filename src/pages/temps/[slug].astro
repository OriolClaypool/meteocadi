---
// El temps a cada lloc (català). La versió en castellà és a /es/tiempo/[slug]; totes dues fan servir PlacePage.
import PlacePage from '../../components/PlacePage.astro';
import { PLACES } from '../../lib/places.js';

export function getStaticPaths() {
  return PLACES.map((p) => ({ params: { slug: p.slug } }));
}
---
<PlacePage slug={Astro.params.slug} lang="ca" />
