---
import Base from '../../layouts/Base.astro';
import StationTable from '../../components/StationTable.astro';
import Forecast from '../../components/Forecast.astro';
import MountainNotice from '../../components/MountainNotice.astro';
import MountainForecast from '../../components/MountainForecast.astro';
import { PLACES, PLACE_BY_SLUG, isMountain, isRoad, distanceKm } from '../../lib/places.js';
import { fetchMountain, mountainText, lowerCommon } from '../../lib/mountain.js';
import { BY_ID, fmtAlt } from '../../lib/stations.js';
import { stationRecords } from '../../lib/archive.js';
import { dailyForecast } from '../../lib/forecast-build.js';
import { wmoText } from '../../lib/wmo.js';
import { num, longDate, cap, desDe, tempColorLight } from '../../lib/format.js';

export function getStaticPaths() {
  return PLACES.map((p) => ({ params: { slug: p.slug } }));
}

const p = PLACE_BY_SLUG[Astro.params.slug];
const main = BY_ID[p.stations[0]];
const rec = stationRecords(main.id);
const fc = await dailyForecast(p, 3);
const mountain = isMountain(p) && p.points?.length;
const road = isRoad(p);
const hub = mountain && !road; // les pàgines de muntanya pengen de /muntanya
const mdata = mountain ? await fetchMountain(p.points) : null;
const mtext = mountain ? mountainText(mdata, p) : [];
const dist = distanceKm(p, main);
const distTxt = dist >= 0.5 ? `, a ${dist < 1 ? 'menys d\'1 km' : `${num(dist, 1)} km`}` : '';

const dayText = (d) => {
  if (!d) return '';
  const rain = d.rain >= 0.2 ? `, amb ${num(d.rain)} mm de pluja prevista${d.prob != null ? ` (probabilitat del ${d.prob} %)` : ''}` : ', sense pluja prevista';
  const wind = d.gust != null && d.gust >= 40 ? ` Ratxes de fins a ${Math.round(d.gust)} km/h.` : '';
  return `${cap(longDate(d.date))}: ${wmoText(d.code).toLowerCase()}, màxima de ${Math.round(d.max)} °C i mínima de ${Math.round(d.min)} °C${rain}.${wind}`;
};
const kindWord = { poble: 'el poble', cim: 'la muntanya', coll: 'el coll', esqui: "l'estació d'esquí", refugi: 'el refugi', carretera: 'la carretera' }[p.kind] ?? 'el lloc';
const title = `El temps ${p.a}: ara, previsió per hores i historial | Meteocadí`;
const description = road
  ? `Temps ${p.a}: previsió a les dues boques (${p.points.map((x) => fmtAlt(x.alt)).join(' i ')}) amb temperatura, precipitació, neu i isoterma de 0 °C, i dades en directe de l'estació ${main.name}. Estat de la carretera: Servei Català de Trànsit.`
  : mountain
  ? `Temps ${p.a}: vent, sensació tèrmica, isoterma i neu previstos ${p.points.map((x) => `a ${fmtAlt(x.alt)}`).join(' i ')}, i dades en directe de l'estació ${main.name} (${fmtAlt(main.alt)}).`
  : `Temps ${p.a} (${fmtAlt(p.alt)}): temperatura i vent en directe de l'estació ${main.name}, previsió per hores i per a 7 dies calculada per a l'altitud de ${kindWord}, i historial diari.`;
const others = PLACES.filter((x) => x.slug !== p.slug);
const ld = [
  {
    '@type': 'Place',
    name: p.name,
    geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng, elevation: p.alt },
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Berguedà' },
    url: `https://www.meteocadi.cat/temps/${p.slug}`,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inici', item: 'https://www.meteocadi.cat/' },
      hub ? { '@type': 'ListItem', position: 2, name: 'Muntanya', item: 'https://www.meteocadi.cat/muntanya' } : { '@type': 'ListItem', position: 2, name: 'Pobles i cims', item: 'https://www.meteocadi.cat/temps' },
      { '@type': 'ListItem', position: 3, name: `El temps ${p.a}`, item: `https://www.meteocadi.cat/temps/${p.slug}` },
    ],
  },
];
---
<Base title={title} description={description} path={`/temps/${p.slug}`} jsonLd={ld} current={hub ? 'muntanya' : 'temps'}>
  <section class="phead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Ruta"><a href="/">Inici</a><span>›</span>{hub ? <a href="/muntanya">Muntanya</a> : <a href="/temps">Pobles i cims</a>}<span>›</span><span>{p.name}</span></nav>
      <h1>El temps {p.a}</h1>
      <p>{fmtAlt(p.alt)} d'altitud · Estació de referència: <a href={`/estacions/${main.slug}`}>{main.name}</a> ({fmtAlt(main.alt)}){distTxt}.</p>
      {mountain && mtext.length > 0 && (
        <div class="prose" style="margin-top:22px;font-size:17px;">
          {mtext.map((t) => <p>{t}</p>)}
        </div>
      )}
      {mountain && <div style="margin-top:22px;"><MountainNotice short road={road} /></div>}
      {(!mountain || mtext.length === 0) && fc && (
        <div class="prose" style="margin-top:22px;font-size:17px;">
          {fc.slice(0, 2).map((d) => <p>{dayText(d)}</p>)}
        </div>
      )}
    </div>
  </section>

  <section class="sec sec--dark" style="padding:64px 0;">
    <div class="wrap" style="position:relative;">
      <div class="sec__head">
        <div>
          <span class="eyebrow"><span class="live live--off" data-live-badge style="padding:6px 12px;"><span class="live__dot"><i></i><i></i></span><span data-live-text>CONNECTANT…</span></span></span>
          <h2 class="h2">Ara {p.a}</h2>
        </div>
        <a href="/estacions" style="color:#7fd0ff;font-size:15px;">Totes les estacions</a>
      </div>
      <StationTable ids={p.stations} />
    </div>
  </section>

  {mountain && (
    <section class="sec">
      <div class="wrap">
        <MountainForecast points={p.points} data={mdata} title={road ? 'Condicions previstes a les boques' : undefined} sub={`Calculada per a ${p.points.map((x) => `${fmtAlt(x.alt)} (${lowerCommon(x.label)})`).join(' i per a ')}.`} />
      </div>
    </section>
  )}

  <section class="sec sec--pale">
    <div class="wrap">
      <Forecast place={{ name: p.name, lat: p.lat, lng: p.lng, alt: p.alt }} title={`Previsió ${p.a}`} sub={`Per hores les pròximes 48 hores i per dies tota la setmana, per a ${fmtAlt(p.alt)} d'altitud.`} />
    </div>
  </section>

  <section class="sec">
    <div class="wrap grid2" style="gap:64px;align-items:start;">
      <div class="prose">
        <h2 style="margin-top:0;">El temps {p.a}</h2>
        {p.intro.map((t) => <p>{t}</p>)}
        <p><a href="/cap-de-setmana">Què farà aquest cap de setmana {p.a} i a la resta de la zona →</a></p>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;">
        {rec ? (
          <>
            <h2 style="font-size:24px;font-weight:800;">Dades de l'arxiu · {main.name}</h2>
            <p style="color:var(--muted);font-size:15px;">{cap(desDe(rec.from))} ({rec.days} dies arxivats).</p>
            <div class="recs" style="grid-template-columns:1fr 1fr;">
              <div class="card"><span class="eyebrow">Màxima més alta</span><p class="mono" style={`font-size:30px;color:${tempColorLight(rec.maxHigh?.tempHigh)}`}>{num(rec.maxHigh?.tempHigh)}°</p><p style="color:var(--muted);font-size:14px;">{rec.maxHigh && longDate(rec.maxHigh.date)}</p></div>
              <div class="card"><span class="eyebrow">Mínima més baixa</span><p class="mono" style={`font-size:30px;color:${tempColorLight(rec.minLow?.tempLow)}`}>{num(rec.minLow?.tempLow)}°</p><p style="color:var(--muted);font-size:14px;">{rec.minLow && longDate(rec.minLow.date)}</p></div>
              <div class="card"><span class="eyebrow">Mitjana de màximes</span><p class="mono" style="font-size:30px;">{num(rec.avgHigh)}°</p></div>
              <div class="card"><span class="eyebrow">Pluja acumulada</span><p class="mono" style="font-size:30px;">{num(rec.rainTotal)} <small style="font-size:15px;color:var(--muted)">mm</small></p></div>
            </div>
            <a href={`/estacions/${main.slug}`} class="link-arrow">Historial complet de l'estació →</a>
          </>
        ) : (
          <p style="color:var(--muted)">L'arxiu diari d'aquesta estació encara s'està omplint.</p>
        )}
      </div>
    </div>
  </section>

  {mountain && (
    <section class="sec" style="padding:56px 0 8px;">
      <div class="wrap"><MountainNotice road={road} /></div>
    </section>
  )}

  <section class="sec sec--pale" style="padding:64px 0;">
    <div class="wrap">
      {hub && <p style="margin-bottom:18px;"><a class="link-arrow" href="/muntanya">Condicions a tots els cims i estacions d'esquí →</a></p>}
      <h2 style="font-size:24px;font-weight:800;margin-bottom:16px;">El temps a altres llocs de la zona</h2>
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
        {others.map((x) => <a class="btn btn--line" style="height:44px;font-size:15px;background:#fff;" href={`/temps/${x.slug}`}>{x.name}</a>)}
      </div>
    </div>
  </section>
</Base>

<script>
  import { startLive } from '../../scripts/live.js';
  startLive();
</script>
