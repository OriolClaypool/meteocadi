---
import Base from '../layouts/Base.astro';
import WindLines from '../components/WindLines.astro';
import Icon from '../components/Icons.astro';
import StationTable from '../components/StationTable.astro';
import Forecast from '../components/Forecast.astro';
import Explora from '../components/Explora.astro';
import Perfil from '../components/Perfil.astro';
import { STATIONS, fmtAlt } from '../lib/stations.js';
import { PLACE_BY_SLUG, FORECAST_CHIPS } from '../lib/places.js';
import { latestDay, extremes } from '../lib/archive.js';
import { tempColor, num, dayShort, dayMonthShort } from '../lib/format.js';

const day = latestDay();
const ex = extremes(day);
const chips = FORECAST_CHIPS.map((s) => PLACE_BY_SLUG[s]).map((p) => ({ name: p.name, lat: p.lat, lng: p.lng, alt: p.alt }));
const ARROW = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>';
const altRange = `${fmtAlt(Math.min(...STATIONS.map((s) => s.alt))).replace(' m', '')} i els ${fmtAlt(Math.max(...STATIONS.map((s) => s.alt))).replace(' m', '')} metres`;
const who = (e) => (e ? `${e.station.name.split(' - ')[0]} · ${fmtAlt(e.station.alt)}` : '');
const dateLabel = day ? `${dayShort(day.date)} ${dayMonthShort(day.date)}`.toUpperCase() : '';

const CONT = 'M-200 -20C-190 -140 -40 -190 80 -160C200 -130 260 -40 230 60C200 160 60 190 -60 170C-170 150 -210 80 -200 -20Z';
const contours = [...Array(10).keys()].map((j) => `translate(1180 260) rotate(${-8 + 3 * j}) scale(${(0.35 + 0.34 * j + 0.03 * j * j).toFixed(2)})`);
---
<Base
  title="El temps al Cadí-Moixeró i el Berguedà en directe | Meteocadí"
  description={`Temperatura, vent i pluja en directe de ${STATIONS.length} estacions meteorològiques entre Bagà, Gósol, el Pedraforca i el Coll de Pal, amb previsió per hores i l'historial diari.`}
  path="/"
  header="overlay"
  preload="/imatges/portada-1600.webp"
>
  <section class="hero">
    <picture class="hero__img">
      <source media="(max-width: 640px)" srcset="/imatges/portada-mobil-800.webp" type="image/webp" />
      <source srcset="/imatges/portada-1000.webp 1000w, /imatges/portada-1600.webp 1600w, /imatges/portada-2400.webp 2400w" sizes="100vw" type="image/webp" />
      <img src="/imatges/portada-1600.jpg" alt="La serralada nevada sobre la vall, amb el poble i els camps coberts de neu" width="1600" height="911" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__shade"></div>
    <div class="hero__shade2"></div>
    <WindLines />
    <div class="wrap hero__body">
      <div class="hero__text a-rise">
        <span class="kicker">Xarxa meteorològica del Cadí-Moixeró i el Berguedà</span>
        <h1>El temps al Cadí,<br /><em>de la vall al cim.</em></h1>
        <p class="hero__lead">{STATIONS.length} estacions entre els {altRange}, en directe: temperatura, vent i pluja de Bagà al Pedraforca.</p>
        <div class="hero__btns">
          <a href="/estacions" class="btn btn--light">Veure les estacions <Fragment set:html={ARROW} /></a>
          <a href="/mapa" class="btn btn--ghost">Mapa en directe</a>
          <a href="/cap-de-setmana" class="btn" style="color:#fff;text-decoration:underline;text-underline-offset:5px;text-decoration-color:rgba(255,255,255,.5);padding:0 8px;font-weight:600;">Aquest cap de setmana</a>
        </div>
      </div>
      {ex && (
        <aside class="panel resum a-rise" style="animation-delay:.3s" aria-labelledby="resum-t">
          <div class="resum__head">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <span class="eyebrow" id="resum-t" data-resum-label data-date={day.date}>RESUM · {dateLabel}</span>
              <span style="font-size:15px;color:#c3cfde;">Els extrems de les {ex.n} estacions amb dades</span>
            </div>
            <a href="/historial" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;">Historial <Fragment set:html={ARROW} /></a>
          </div>
          <div class="resum__grid">
            <div class="stat">
              <span class="stat__lab"><Icon name="up" color="#ef4444" />MÀXIMA</span>
              <span class="stat__val" style={`color:${tempColor(ex.max?.v)}`}><span data-count={ex.max?.v}>{num(ex.max?.v)}</span><small>°C</small></span>
              <span class="stat__who">{who(ex.max)}</span>
            </div>
            <div class="stat">
              <span class="stat__lab"><Icon name="down" color="#2dd4bf" />MÍNIMA</span>
              <span class="stat__val" style={`color:${tempColor(ex.min?.v)}`}><span data-count={ex.min?.v}>{num(ex.min?.v)}</span><small>°C</small></span>
              <span class="stat__who">{who(ex.min)}</span>
            </div>
            <div class="stat">
              <span class="stat__lab"><Icon name="wind" />RATXA MÀXIMA</span>
              <span class="stat__val" style={`color:${(ex.gust?.v ?? 0) >= 40 ? '#fbbf24' : '#e6edf6'}`}><span data-count={ex.gust?.v}>{num(ex.gust?.v)}</span><small>km/h</small></span>
              <span class="stat__who">{who(ex.gust)}</span>
            </div>
            <div class="stat">
              <span class="stat__lab"><Icon name="drop" />PLUJA</span>
              <span class="stat__val" style={`color:${(ex.rain?.v ?? 0) > 0 ? '#60a5fa' : '#93a3b8'}`}><span data-count={ex.rain?.v ?? 0}>{num(ex.rain?.v ?? 0)}</span><small>mm</small></span>
              <span class="stat__who">{(ex.rain?.v ?? 0) > 0 ? `${who(ex.rain)} · ${ex.rainyStations} estacions amb pluja` : "Cap estació n'ha recollit"}</span>
            </div>
          </div>
          <div class="resum__foot">
            <span>Arxiu diari de la xarxa</span>
            <a href="/historial" style="display:inline-flex;align-items:center;gap:6px;">Tots els dies <Fragment set:html={ARROW} /></a>
          </div>
        </aside>
      )}
    </div>
    <div class="hero__credit">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
      <span>Foto: Meteocadí</span>
    </div>
  </section>

  <div class="ticker" aria-label="Temperatura actual a les estacions">
    <div class="ticker__live"><span class="live live--off" data-live-badge><span class="live__dot"><i></i><i></i></span><span data-live-text>CONNECTANT…</span></span></div>
    <div class="ticker__track">
      <div class="ticker__move">
        {[0, 1].map((copy) => (
          <div class="ticker__set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {STATIONS.map((s) => (
              <>
                <a class="tk" href={`/estacions/${s.slug}`} data-tk={s.id} tabindex={copy === 1 ? '-1' : undefined}>
                  <b>{s.name.split(' - ')[0]}</b><span class="a">{fmtAlt(s.alt)}</span><span class="t">—</span><span class="w"></span>
                </a>
                <span class="tk-sep"></span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="sec sec--dark" id="estacions">
    <svg class="contours" viewBox="0 0 1440 900" aria-hidden="true"><g fill="none" stroke="#3db8ff" stroke-opacity="0.07">{contours.map((t) => <path vector-effect="non-scaling-stroke" transform={t} d={CONT}></path>)}</g></svg>
    <div class="wrap" style="position:relative;">
      <div class="sec__head">
        <div>
          <span class="eyebrow" data-live-count>LECTURES EN DIRECTE</span>
          <h2 class="h2">Les estacions, ara</h2>
        </div>
        <div class="filters" role="group" aria-label="Filtra les estacions">
          <button type="button" class="fbtn" aria-pressed="true" data-filter="totes">Totes</button>
          <button type="button" class="fbtn" aria-pressed="false" data-filter="alta">Alta muntanya</button>
          <button type="button" class="fbtn" aria-pressed="false" data-filter="vall">Vall i Prepirineu</button>
          <a href="/mapa" style="display:inline-flex;align-items:center;gap:8px;margin-left:12px;font-size:14px;color:#7fd0ff;">Veure-les al mapa <Fragment set:html={ARROW} /></a>
        </div>
      </div>
      <StationTable />
      <p class="st-note">Dades de les estacions via Weather Underground, actualitzades cada 15 minuts. Toca una estació per veure'n el detall.</p>
    </div>
  </section>

  <section class="sec sec--pale" id="previsio">
    <div class="wrap">
      <Forecast chips={chips} title="Les pròximes 48 hores" sub="Previsió cada tres hores: cel, temperatura, pluja i vent, calculada per a l'altitud de cada lloc." />
    </div>
  </section>

  <Explora />
  <Perfil />
</Base>

<script>
  import { startLive } from '../scripts/live.js';
  import { todayMadrid } from '../lib/format.js';
  startLive();

  // "Resum d'ahir" si el darrer dia arxivat és ahir
  const lab = document.querySelector('[data-resum-label]') as HTMLElement | null;
  if (lab) {
    const y = new Date(Date.now() - 86400000);
    if (lab.dataset.date === todayMadrid(y)) lab.textContent = `RESUM D'AHIR · ${lab.textContent?.split('· ')[1] ?? ''}`;
  }

  // Filtres de la taula
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        g.hidden = b.dataset.filter !== 'totes' && g.dataset.group !== b.dataset.filter;
      });
    }),
  );

  // Recompte animat del resum
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    const targets = Array.from(els).map((el) => ({ el, v: Number(el.dataset.count) }));
    const t0 = performance.now() + 500;
    const tick = (now: number) => {
      const p = Math.max(0, Math.min(1, (now - t0) / 1600));
      const e = 1 - Math.pow(1 - p, 3);
      targets.forEach(({ el, v }) => { if (!isNaN(v)) el.textContent = (v * e).toFixed(1).replace('.', ',').replace('-', '−'); });
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
