---
import Base from '../layouts/Base.astro';
import WindLines from '../components/WindLines.astro';
import Icon from '../components/Icons.astro';
import StationTable from '../components/StationTable.astro';
import Forecast from '../components/Forecast.astro';
import Explora from '../components/Explora.astro';
import Perfil from '../components/Perfil.astro';
import SkiHome from '../components/SkiHome.astro';
import CatalunyaAra from '../components/CatalunyaAra.astro';
import { STATIONS, fmtAlt } from '../lib/stations.js';
import { PLACE_BY_SLUG, forecastChips } from '../lib/places.js';
import { inSeason } from '../lib/ski.js';
import { latestDay, extremes } from '../lib/archive.js';
import { episodes } from '../lib/episodes.js';
import { tempColor, num, dayShort, dayMonthShort, todayMadrid } from '../lib/format.js';

const day = latestDay();
const ex = extremes(day);
// Episodi destacat recent (acabat fa com a molt 6 dies respecte del darrer dia arxivat)
const recent = episodes().find((e) => day && (Date.parse(day.date) - Date.parse(e.end)) / 864e5 <= 6);
const skiSeason = inSeason(todayMadrid());
const chips = forecastChips(todayMadrid()).map((s) => PLACE_BY_SLUG[s]).map((p) => ({ name: p.name, lat: p.lat, lng: p.lng, alt: p.alt }));
const ARROW = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>';
const altRange = `${fmtAlt(Math.min(...STATIONS.map((s) => s.alt))).replace(' m', '')} i els ${fmtAlt(Math.max(...STATIONS.map((s) => s.alt))).replace(' m', '')} metres`;
const who = (e) => (e ? `${e.station.name.split(' - ')[0]} · ${fmtAlt(e.station.alt)}` : '');
const dateLabel = day ? `${dayShort(day.date)} ${dayMonthShort(day.date)}`.toUpperCase() : '';

const CONT = 'M-200 -20C-190 -140 -40 -190 80 -160C200 -130 260 -40 230 60C200 160 60 190 -60 170C-170 150 -210 80 -200 -20Z';
const contours = [...Array(10).keys()].map((j) => `translate(1180 260) rotate(${-8 + 3 * j}) scale(${(0.35 + 0.34 * j + 0.03 * j * j).toFixed(2)})`);
---
<Base
  title="El temps al Cadí-Moixeró i el Berguedà en directe | Meteocadí"
  description={`Temperatura, vent i pluja en directe de ${STATIONS.length} estacions meteorològiques entre Bagà, Gósol, el Pedraforca i el Coll de Pal, amb previsió per hores i l'historial diari.`}
  path="/"
  header="overlay"
  preload="/imatges/portada-1600.webp"
>
  <section class="hero">
    <picture class="hero__img">
      <source media="(max-width: 640px)" srcset="/imatges/portada-mobil-800.webp" type="image/webp" />
      <source srcset="/imatges/portada-1000.webp 1000w, /imatges/portada-1600.webp 1600w, /imatges/portada-2400.webp 2400w" sizes="100vw" type="image/webp" />
      <img src="/imatges/portada-1600.jpg" alt="La serralada nevada sobre la vall, amb el poble i els camps coberts de neu" width="1600" height="911" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__shade"></div>
    <div class="hero__shade2"></div>
    <WindLines />
    <div class="wrap hero__body">
      <div class="hero__text a-rise">
        <span class="kicker">Xarxa meteorològica del Cadí-Moixeró i el Berguedà</span>
        <h1>El temps al Cadí,<br /><em>de la vall al cim.</em></h1>
        <p class="hero__lead">{STATIONS.length} estacions entre els {altRange}, en directe: temperatura, vent i pluja de Bagà al Pedraforca.</p>
        <div class="hero__btns">
          <a href="/estacions" class="btn btn--light">Veure les estacions <Fragment set:html={ARROW} /></a>
          <a href="/mapa" class="btn btn--ghost">Mapa en directe</a>
          <a href="/cap-de-setmana" class="btn" style="color:#fff;text-decoration:underline;text-underline-offset:5px;text-decoration-color:rgba(255,255,255,.5);padding:0 8px;font-weight:600;">Aquest cap de setmana</a>
        </div>
      </div>
      {ex && (
        <aside class="panel resum a-rise" style="animation-delay:.3s" aria-labelledby="resum-t">
          <div class="resum__head">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <span class="eyebrow" id="resum-t" data-resum-label data-date={day.date}>RESUM · {dateLabel}</span>
              <span style="font-size:15px;color:#c3cfde;" data-rs-sub>Els extrems de les {ex.n} estacions amb dades</span>
            </div>
            <a href="/historial" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;">Historial <Fragment set:html={ARROW} /></a>
          </div>
          <div class="resum__grid">
            <div class="stat">
              <span class="stat__lab"><Icon name="up" color="#ef4444" />MÀXIMA</span>
              <span class="stat__val" data-rsv="max" style={`color:${tempColor(ex.max?.v)}`}><span data-count={ex.max?.v}>{num(ex.max?.v)}</span><small>°C</small></span>
              <span class="stat__who" data-rsw="max">{who(ex.max)}</span>
            </div>
            <div class="stat">
              <span class="stat__lab"><Icon name="down" color="#2dd4bf" />MÍNIMA</span>
              <span class="stat__val" data-rsv="min" style={`color:${tempColor(ex.min?.v)}`}><span data-count={ex.min?.v}>{num(ex.min?.v)}</span><small>°C</small></span>
              <span class="stat__who" data-rsw="min">{who(ex.min)}</span>
            </div>
            <div class="stat">
              <span class="stat__lab"><Icon name="wind" />RATXA MÀXIMA</span>
              <span class="stat__val" data-rsv="gust" style={`color:${(ex.gust?.v ?? 0) >= 40 ? '#fbbf24' : '#e6edf6'}`}><span data-count={ex.gust?.v}>{num(ex.gust?.v)}</span><small>km/h</small></span>
              <span class="stat__who" data-rsw="gust">{who(ex.gust)}</span>
            </div>
            <div class="stat">
              <span class="stat__lab"><Icon name="drop" />PLUJA</span>
              <span class="stat__val" data-rsv="rain" style={`color:${(ex.rain?.v ?? 0) > 0 ? '#60a5fa' : '#93a3b8'}`}><span data-count={ex.rain?.v ?? 0}>{num(ex.rain?.v ?? 0)}</span><small>mm</small></span>
              <span class="stat__who" data-rsw="rain">{(ex.rain?.v ?? 0) > 0 ? `${who(ex.rain)} · ${ex.rainyStations} estacions amb pluja` : "Cap estació n'ha recollit"}</span>
            </div>
          </div>
          <div class="resum__foot">
            <span data-rs-foot>Arxiu diari de la xarxa</span>
            <a href="/historial" style="display:inline-flex;align-items:center;gap:6px;">Tots els dies <Fragment set:html={ARROW} /></a>
          </div>
        </aside>
      )}
    </div>
  </section>

  <div class="ticker" aria-label="Temperatura actual a les estacions">
    <div class="ticker__live"><span class="live live--off" data-live-badge><span class="live__dot"><i></i><i></i></span><span data-live-text>CONNECTANT…</span></span></div>
    <div class="ticker__track">
      <div class="ticker__move">
        {[0, 1].map((copy) => (
          <div class="ticker__set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {STATIONS.map((s) => (
              <>
                <a class="tk" href={`/estacions/${s.slug}`} data-tk={s.id} tabindex={copy === 1 ? '-1' : undefined}>
                  <b>{s.name.split(' - ')[0]}</b><span class="a">{fmtAlt(s.alt)}</span><span class="t">—</span><span class="w"></span>
                </a>
                <span class="tk-sep"></span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  {recent && (
    <a class={`epstrip ep--${recent.type}`} href={`/episodis/${recent.slug}`}>
      <div class="wrap">
        <b>{recent.label}</b>
        <span>{recent.rangeText.charAt(0).toUpperCase() + recent.rangeText.slice(1)}: {recent.headline.v} {recent.headline.u} a {recent.headline.where}</span>
        <u>Llegeix el resum ›</u>
      </div>
    </a>
  )}

  <section class="sec sec--dark" id="estacions">
    <svg class="contours" viewBox="0 0 1440 900" aria-hidden="true"><g fill="none" stroke="#3db8ff" stroke-opacity="0.07">{contours.map((t) => <path vector-effect="non-scaling-stroke" transform={t} d={CONT}></path>)}</g></svg>
    <div class="wrap" style="position:relative;">
      <div class="sec__head">
        <div>
          <span class="eyebrow" data-live-count>LECTURES EN DIRECTE</span>
          <h2 class="h2">Les estacions, ara</h2>
        </div>
        <div class="filters">
          <a href="/estacions" style="display:inline-flex;align-items:center;gap:8px;font-size:14px;color:#7fd0ff;">Les {STATIONS.length} estacions <Fragment set:html={ARROW} /></a>
          <a href="/mapa" style="display:inline-flex;align-items:center;gap:8px;margin-left:18px;font-size:14px;color:#7fd0ff;">Veure-les al mapa <Fragment set:html={ARROW} /></a>
        </div>
      </div>
      <StationTable />
      <p class="st-note">Les d'alta muntanya hi són sempre. De la vall i el Prepirineu, hi surten les quatre amb les dades més destacades del moment: la pluja, el vent, la calor o el fred (si no passa res especial, van rotant). Dades via Weather Underground, cada 15 minuts. Toca una estació per veure'n el detall.</p>
    </div>
  </section>

  {skiSeason && <SkiHome />}

  <section class="sec sec--pale" id="previsio">
    <div class="wrap">
      <Forecast chips={chips} title="Les pròximes 48 hores" sub="Previsió cada tres hores: cel, temperatura, pluja i vent, calculada per a l'altitud de cada lloc." />
    </div>
  </section>

  {!skiSeason && <SkiHome />}

  <CatalunyaAra />

  <Explora />
  <Perfil />
</Base>

<script>
  import { startLive } from '../scripts/live.js';
  import { todayMadrid, hourMadrid, tempColor } from '../lib/format.js';
  import { STATIONS, fmtAlt } from '../lib/stations.js';
  // "Resum d'ahir" si el darrer dia arxivat és ahir
  const lab = document.querySelector('[data-resum-label]') as HTMLElement | null;
  if (lab) {
    const y = new Date(Date.now() - 86400000);
    if (lab.dataset.date === todayMadrid(y)) lab.textContent = `RESUM D'AHIR · ${lab.textContent?.split('· ')[1] ?? ''}`;
  }

  // Estacions de vall de la taula: les quatre amb les dades més destacades (pluja, vent, calor, fred).
  // Si no passa res especial, van rotant cada dia. Les tres de Bagà compten com una.
  const VALL = Array.from(document.querySelectorAll<HTMLElement>('[data-group="vall"] [data-row]'));
  const BAGA = new Set(['IBAG65', 'IBAG73', 'IBAG72']);
  const SHOW = 4;
  function pick(j: any) {
    if (!VALL.length) return;
    const st = j?.stations || {};
    const rows = VALL.map((el, i) => ({ el, i, id: el.dataset.row as string, d: st[el.dataset.row as string] }));
    const live = rows.filter((r) => r.d && !r.d.stale);
    const med = (a: (number | null | undefined)[]) => { const v = a.filter((x): x is number => x != null).sort((p, q) => p - q); return v.length ? v[Math.floor(v.length / 2)] : null; };
    const mMax = med(live.map((r) => r.d.max)), mMin = med(live.map((r) => r.d.min));
    const doy = Math.floor(Date.now() / 864e5);
    const score = (r: any) => {
      let s = ((doy + r.i) % rows.length) * 0.5;
      const d = r.d;
      if (!d || d.stale) return j ? -1e6 + s : s;
      if (d.rain >= 0.2) s += 100 + d.rain * 8;
      const g = d.gustMax ?? d.gust;
      if (g != null && g >= 40) s += (g - 30) * 1.5;
      if (d.max != null) { if (d.max >= 30) s += 20 + (d.max - 30) * 6; if (mMax != null) s += Math.max(0, d.max - mMax - 1) * 4; }
      if (d.min != null) { if (d.min <= 0) s += 25 - d.min * 5; if (mMin != null) s += Math.max(0, mMin - d.min - 1) * 4; }
      return s;
    };
    const chosen: any[] = [];
    let baga = false;
    for (const r of rows.map((r) => ({ ...r, s: score(r) })).sort((a, b) => b.s - a.s)) {
      if (chosen.length >= SHOW) break;
      if (BAGA.has(r.id)) { if (baga) continue; baga = true; }
      chosen.push(r);
    }
    const box = VALL[0].parentElement!;
    VALL.forEach((el) => (el.style.display = 'none'));
    chosen.forEach((r) => { r.el.style.display = ''; box.appendChild(r.el); });
    const count = box.querySelector('.st-group span:last-child');
    if (count) count.textContent = `${chosen.length} de ${VALL.length} · les més destacades`;
  }
  pick(null);
  document.addEventListener('meteocadi:ara', (e) => pick((e as CustomEvent).detail));

  // Recompte animat del resum
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt1 = (v: number) => v.toFixed(1).replace('.', ',').replace('-', '−');
  function countUp(els: HTMLElement[], delay = 500) {
    const targets = els.map((el) => ({ el, v: Number(el.dataset.count) }));
    if (reduce) { targets.forEach(({ el, v }) => { if (!isNaN(v)) el.textContent = fmt1(v); }); return; }
    const t0 = performance.now() + delay;
    const tick = (now: number) => {
      const p = Math.max(0, Math.min(1, (now - t0) / 1600));
      const e = 1 - Math.pow(1 - p, 3);
      targets.forEach(({ el, v }) => { if (!isNaN(v)) el.textContent = fmt1(v * e); });
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // Resum d'avui fins ara (a partir de les 8 del matí, amb les dades en directe). Abans de les 8, o si les dades
  // en directe no arriben, es queda el resum del darrer dia arxivat (ahir).
  const card = document.querySelector<HTMLElement>('.resum');
  const hourNow = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
  const todayMode = !!card && hourNow >= 8;
  let todayShown = false;
  if (todayMode) {
    card!.classList.add('is-wait');
    setTimeout(() => { if (!todayShown) { card!.classList.remove('is-wait'); countUp(Array.from(card!.querySelectorAll<HTMLElement>('[data-count]')), 0); } }, 4000);
  } else if (card) countUp(Array.from(card.querySelectorAll<HTMLElement>('[data-count]')));

  const whoOf = (s: any) => `${s.name.split(' - ')[0]} · ${fmtAlt(s.alt)}`;
  function today(j: any) {
    if (!todayMode || !card) return;
    const live = STATIONS.map((s) => ({ s, d: j?.stations?.[s.id] })).filter((x) => x.d && !x.d.stale);
    if (live.length < 3) return;
    const ok = (v: any, lo: number, hi: number) => typeof v === 'number' && v >= lo && v <= hi;
    const best = (f: (d: any) => any, dir: number, lo: number, hi: number) =>
      live.filter((x) => ok(f(x.d), lo, hi)).sort((a, b) => dir * (f(b.d) - f(a.d)))[0];
    const mx = best((d) => d.max, 1, -40, 48);
    const mn = best((d) => d.min, -1, -40, 48);
    const gs = best((d) => d.gustMax ?? d.gust, 1, 0, 250);
    const rn = best((d) => d.rain, 1, 0, 500);
    const rainy = live.filter((x) => ok(x.d.rain, 0.1, 500)).length;
    const set = (k: string, v: number | undefined, color: string, whoTxt: string) => {
      const val = card.querySelector<HTMLElement>(`[data-rsv="${k}"]`);
      const num = val?.querySelector<HTMLElement>('[data-count]');
      if (!val || !num || v == null) return;
      val.style.color = color;
      num.dataset.count = String(v);
      if (todayShown) num.textContent = fmt1(v);
      const w = card.querySelector<HTMLElement>(`[data-rsw="${k}"]`);
      if (w) w.textContent = whoTxt;
    };
    if (mx) set('max', mx.d.max, tempColor(mx.d.max), whoOf(mx.s));
    if (mn) set('min', mn.d.min, tempColor(mn.d.min), whoOf(mn.s));
    if (gs) { const g = gs.d.gustMax ?? gs.d.gust; set('gust', g, g >= 40 ? '#fbbf24' : '#e6edf6', whoOf(gs.s)); }
    const r = rn?.d.rain ?? 0;
    set('rain', r, r > 0 ? '#60a5fa' : '#93a3b8', r > 0 && rn ? `${whoOf(rn.s)} · ${rainy} ${rainy === 1 ? 'estació' : 'estacions'} amb pluja` : "Cap estació n'ha recollit");
    const lab = card.querySelector<HTMLElement>('[data-resum-label]');
    if (lab) lab.textContent = `AVUI FINS ARA · ${hourMadrid(new Date(j.updated || Date.now()))}`;
    const sub = card.querySelector<HTMLElement>('[data-rs-sub]');
    if (sub) sub.textContent = `Els extrems de les ${live.length} estacions en directe`;
    const foot = card.querySelector<HTMLElement>('[data-rs-foot]');
    if (foot) foot.textContent = "En directe · s'actualitza cada 15 minuts";
    if (!todayShown) {
      todayShown = true;
      card.classList.remove('is-wait');
      countUp(Array.from(card.querySelectorAll<HTMLElement>('[data-count]')), 0);
    }
  }
  document.addEventListener('meteocadi:ara', (e) => today((e as CustomEvent).detail));
  startLive();
</script>
