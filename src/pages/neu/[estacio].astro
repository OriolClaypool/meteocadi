---
// Meteocadí Neu, fitxa d'una estació en català. Tot és a src/components/neu/NeuFitxa.astro, que fa també la versió
// en castellà.
import NeuFitxa from '../../components/neu/NeuFitxa.astro';
import { NEU } from '../../lib/neu/estacions.js';

export function getStaticPaths() {
  return NEU.map((r) => ({ params: { estacio: r.slug } }));
}
---
<NeuFitxa slug={Astro.params.estacio as string} lang="ca" />
