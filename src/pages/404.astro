---
import Base from '../layouts/Base.astro';
---
<Base title="Pàgina no trobada | Meteocadí" description="Aquesta pàgina no existeix." path="/404" noindex>
  <section class="phead" style="padding:120px 0;">
    <div class="wrap">
      <h1>Aquesta pàgina <em>no existeix</em></h1>
      <p>Potser l'adreça ha canviat amb la nova web. Prova-ho des d'aquí:</p>
      <p style="margin-top:22px;display:flex;flex-wrap:wrap;gap:12px;">
        <a class="btn btn--blue" href="/">Inici</a>
        <a class="btn btn--line" href="/estacions">Estacions</a>
        <a class="btn btn--line" href="/temps">Pobles i cims</a>
      </p>
    </div>
  </section>
</Base>
